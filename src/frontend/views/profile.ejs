<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .glass-effect {
            background: rgba(167, 243, 208, 0.2);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .profile-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.7));
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .stat-card {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05));
            border: 1px solid rgba(16, 185, 129, 0.2);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-green-50 to-blue-50 min-h-screen">
    <!-- Header -->
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
                <i class="fas fa-user-circle text-green-600 mr-3"></i>
                Perfil de Usuario
            </h1>
            <p class="text-gray-600">Gestiona tu información personal y configuración de cuenta</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Perfil Principal -->
            <div class="lg:col-span-2">
                <div class="profile-card rounded-2xl shadow-xl p-6">
                    <div class="flex items-center space-x-6 mb-6">
                        <div class="w-20 h-20 bg-gradient-to-br from-green-400 to-green-600 rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-white text-2xl"></i>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900">Dr. Juan Pérez</h2>
                            <p class="text-gray-600">Investigador en Micología</p>
                            <p class="text-sm text-green-600 mt-1">
                                <i class="fas fa-calendar-alt mr-1"></i>
                                Miembro desde Enero 2024
                            </p>
                        </div>
                    </div>

                    <!-- Información Personal -->
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Información Personal</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
                                    <input type="text" value="Juan" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Apellido</label>
                                    <input type="text" value="Pérez" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                    <input type="email" value="juan.perez@universidad.edu" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono</label>
                                    <input type="text" value="+34 612 345 678" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Institución</label>
                                    <input type="text" value="Universidad de Barcelona - Departamento de Biología" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                            </div>
                        </div>

                                                <!-- Información de Cuenta -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Información de Cuenta</h3>
                            <div class="space-y-4">
                                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                    <div>
                                        <p class="font-medium text-gray-900">Estado de la Cuenta</p>
                                        <p class="text-sm text-gray-600">Tu cuenta está activa y verificada</p>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <span class="w-3 h-3 rounded-full bg-green-500"></span>
                                        <span class="text-sm text-green-600 font-medium">Activa</span>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                    <div>
                                        <p class="font-medium text-gray-900">Plan de Suscripción</p>
                                        <p class="text-sm text-gray-600">Plan académico con acceso completo</p>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <span class="text-sm text-blue-600 font-medium">Académico Pro</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="flex space-x-4 pt-6">
                            <button class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-200">
                                <i class="fas fa-save mr-2"></i>
                                Guardar Cambios
                            </button>
                            <button class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-200">
                                <i class="fas fa-key mr-2"></i>
                                Cambiar Contraseña
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Estadísticas y Actividad -->
            <div class="space-y-6">
                <!-- Estadísticas -->
                <div class="stat-card rounded-2xl shadow-xl p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <i class="fas fa-chart-bar text-green-600 mr-2"></i>
                        Estadísticas de Uso
                    </h3>
                    <div class="space-y-4">
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Análisis Completados</span>
                            <span class="text-2xl font-bold text-green-600">127</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Genomas Procesados</span>
                            <span class="text-2xl font-bold text-blue-600">43</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Horas de Uso</span>
                            <span class="text-2xl font-bold text-purple-600">86h</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Últimos 30 días</span>
                            <span class="text-2xl font-bold text-orange-600">23</span>
                        </div>
                    </div>
                </div>

                <!-- Actividad Reciente -->
                <div class="stat-card rounded-2xl shadow-xl p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <i class="fas fa-clock text-green-600 mr-2"></i>
                        Actividad Reciente
                    </h3>
                    <div class="space-y-3">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-dna text-green-600 text-xs"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-900">Análisis BRAKER3 completado</p>
                                <p class="text-xs text-gray-500">Hace 2 horas</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-chart-line text-blue-600 text-xs"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-900">Visualización BinDash</p>
                                <p class="text-xs text-gray-500">Hace 5 horas</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-download text-purple-600 text-xs"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-900">Descarga de genoma NCBI</p>
                                <p class="text-xs text-gray-500">Hace 1 día</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Accesos Rápidos -->
                <div class="stat-card rounded-2xl shadow-xl p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <i class="fas fa-bolt text-green-600 mr-2"></i>
                        Accesos Rápidos
                    </h3>
                    <div class="space-y-2">
                        <a href="/history" class="flex items-center space-x-2 p-3 rounded-lg hover:bg-gray-50 transition-colors duration-200">
                            <i class="fas fa-history text-gray-600"></i>
                            <span class="text-sm text-gray-700">Ver Historial Completo</span>
                        </a>
                        <a href="/database" class="flex items-center space-x-2 p-3 rounded-lg hover:bg-gray-50 transition-colors duration-200">
                            <i class="fas fa-database text-gray-600"></i>
                            <span class="text-sm text-gray-700">Explorar Genomas</span>
                        </a>
                        <a href="/analyzer" class="flex items-center space-x-2 p-3 rounded-lg hover:bg-gray-50 transition-colors duration-200">
                            <i class="fas fa-microscope text-gray-600"></i>
                            <span class="text-sm text-gray-700">Nuevo Análisis</span>
                        </a>
                        <a href="/config" class="flex items-center space-x-2 p-3 rounded-lg hover:bg-gray-50 transition-colors duration-200">
                            <i class="fas fa-cog text-gray-600"></i>
                            <span class="text-sm text-gray-700">Configuración Avanzada</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script>
        // Toggle switches functionality
        document.querySelectorAll('[type="checkbox"]').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const toggleBg = this.nextElementSibling;
                const toggleDot = toggleBg.querySelector('.toggle-dot');
                
                if (this.checked) {
                    toggleBg.classList.remove('bg-gray-300');
                    toggleBg.classList.add('bg-green-500');
                    toggleDot.classList.add('translate-x-6');
                } else {
                    toggleBg.classList.remove('bg-green-500');
                    toggleBg.classList.add('bg-gray-300');
                    toggleDot.classList.remove('translate-x-6');
                }
            });
        });

        // Cerrar menú de perfil al hacer clic fuera
        document.addEventListener('click', function(event) {
            const profileMenu = document.getElementById('profileMenu');
            const profileButton = profileMenu.previousElementSibling;
            
            if (!profileButton.contains(event.target) && !profileMenu.contains(event.target)) {
                profileMenu.classList.add('hidden');
            }
        });
    </script>
</body>
</html> 