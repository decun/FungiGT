<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/theme-manager.js"></script>
</head>
<body class="theme-bg-primary theme-text-primary min-h-screen">
    <!-- Header -->
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold theme-text-primary mb-2">
                <i class="fas fa-user-circle text-green-600 mr-3"></i>
                Perfil de Usuario
            </h1>
            <p class="theme-text-secondary">Gestiona tu información personal y configuración de cuenta</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Perfil Principal -->
            <div class="lg:col-span-2">
                <div class="theme-card rounded-2xl theme-shadow-light-xl p-6">
                    <div class="flex items-center space-x-6 mb-6">
                        <div class="w-20 h-20 bg-gradient-to-br from-green-400 to-green-600 rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-white text-2xl"></i>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold theme-text-primary">Dr. Juan Pérez</h2>
                            <p class="theme-text-secondary">Investigador en Micología</p>
                            <p class="text-sm text-green-600 mt-1">
                                <i class="fas fa-calendar-alt mr-1"></i>
                                Miembro desde Enero 2024
                            </p>
                        </div>
                    </div>

                    <!-- Información Personal -->
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-semibold theme-text-primary mb-4">Información Personal</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-1">Nombre</label>
                                    <input type="text" value="Juan" class="w-full px-3 py-2 theme-input border rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-1">Apellido</label>
                                    <input type="text" value="Pérez" class="w-full px-3 py-2 theme-input border rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-1">Email</label>
                                    <input type="email" value="juan.perez@universidad.edu" class="w-full px-3 py-2 theme-input border rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-1">Teléfono</label>
                                    <input type="text" value="+34 612 345 678" class="w-full px-3 py-2 theme-input border rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium theme-text-secondary mb-1">Institución</label>
                                    <input type="text" value="Universidad de Barcelona - Departamento de Biología" class="w-full px-3 py-2 theme-input border rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" readonly>
                                </div>
                            </div>
                        </div>

                        <!-- Preferencias del Usuario -->
                        <div>
                            <h3 class="text-lg font-semibold theme-text-primary mb-4">Preferencias</h3>
                            <div class="space-y-4">
                                <div class="flex items-center justify-between p-4 theme-bg-secondary rounded-lg">
                                    <div>
                                        <p class="font-medium theme-text-primary">Tema de la Aplicación</p>
                                        <p class="text-sm theme-text-secondary">Elige entre modo claro y oscuro</p>
                                    </div>
                                    <div class="theme-toggle" title="Cambiar tema">
                                        <i class="fas fa-sun theme-icon sun"></i>
                                        <i class="fas fa-moon theme-icon moon"></i>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between p-4 theme-bg-secondary rounded-lg">
                                    <div>
                                        <p class="font-medium theme-text-primary">Notificaciones</p>
                                        <p class="text-sm theme-text-secondary">Recibir notificaciones de análisis</p>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <input type="checkbox" id="notifications" class="w-4 h-4 text-green-600 rounded theme-input" checked>
                                        <label for="notifications" class="text-sm theme-text-secondary">Activadas</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Información de Cuenta -->
                        <div>
                            <h3 class="text-lg font-semibold theme-text-primary mb-4">Información de Cuenta</h3>
                            <div class="space-y-4">
                                <div class="flex items-center justify-between p-4 theme-bg-secondary rounded-lg">
                                    <div>
                                        <p class="font-medium theme-text-primary">Estado de la Cuenta</p>
                                        <p class="text-sm theme-text-secondary">Tu cuenta está activa y verificada</p>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <span class="w-3 h-3 rounded-full bg-green-500"></span>
                                        <span class="text-sm text-green-600 font-medium">Activa</span>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between p-4 theme-bg-secondary rounded-lg">
                                    <div>
                                        <p class="font-medium theme-text-primary">Plan de Suscripción</p>
                                        <p class="text-sm theme-text-secondary">Plan académico con acceso completo</p>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <span class="text-sm text-blue-600 font-medium">Académico Pro</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="flex space-x-4 pt-6">
                            <button class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-200">
                                <i class="fas fa-save mr-2"></i>
                                Guardar Cambios
                            </button>
                            <button class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors duration-200">
                                <i class="fas fa-key mr-2"></i>
                                Cambiar Contraseña
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Estadísticas y Actividad -->
            <div class="space-y-6">
                <!-- Estadísticas -->
                <div class="theme-card rounded-2xl theme-shadow-light-xl p-6">
                    <h3 class="text-lg font-semibold theme-text-primary mb-4">
                        <i class="fas fa-chart-bar text-green-600 mr-2"></i>
                        Estadísticas de Uso
                    </h3>
                    <div class="space-y-4">
                        <div class="flex justify-between items-center">
                            <span class="theme-text-secondary">Análisis Completados</span>
                            <span class="text-2xl font-bold text-green-600">127</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="theme-text-secondary">Genomas Procesados</span>
                            <span class="text-2xl font-bold text-blue-600">43</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="theme-text-secondary">Horas de Uso</span>
                            <span class="text-2xl font-bold text-purple-600">86h</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="theme-text-secondary">Últimos 30 días</span>
                            <span class="text-2xl font-bold text-orange-600">23</span>
                        </div>
                    </div>
                </div>

                <!-- Actividad Reciente -->
                <div class="theme-card rounded-2xl theme-shadow-light-xl p-6">
                    <h3 class="text-lg font-semibold theme-text-primary mb-4">
                        <i class="fas fa-clock text-green-600 mr-2"></i>
                        Actividad Reciente
                    </h3>
                    <div class="space-y-3">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-dna text-green-600 text-xs"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium theme-text-primary">Análisis BRAKER3 completado</p>
                                <p class="text-xs theme-text-muted">Hace 2 horas</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-chart-line text-blue-600 text-xs"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium theme-text-primary">Visualización BinDash</p>
                                <p class="text-xs theme-text-muted">Hace 5 horas</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-download text-purple-600 text-xs"></i>
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium theme-text-primary">Descarga de genoma NCBI</p>
                                <p class="text-xs theme-text-muted">Hace 1 día</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Accesos Rápidos -->
                <div class="theme-card rounded-2xl theme-shadow-light-xl p-6">
                    <h3 class="text-lg font-semibold theme-text-primary mb-4">
                        <i class="fas fa-bolt text-green-600 mr-2"></i>
                        Accesos Rápidos
                    </h3>
                    <div class="space-y-2">
                        <a href="/history" class="flex items-center space-x-2 p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-history theme-text-secondary"></i>
                            <span class="text-sm theme-text-primary">Historial de Análisis</span>
                        </a>
                        <a href="/config" class="flex items-center space-x-2 p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-cog theme-text-secondary"></i>
                            <span class="text-sm theme-text-primary">Configuración</span>
                        </a>
                        <a href="/analyzer" class="flex items-center space-x-2 p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-microscope theme-text-secondary"></i>
                            <span class="text-sm theme-text-primary">Nuevo Análisis</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script>
        // Inicializar el tema cuando se cargue la página
        document.addEventListener('DOMContentLoaded', function() {
            // Listener para el evento de cambio de tema
            window.addEventListener('themeChanged', function(e) {
                console.log('Tema cambiado a:', e.detail.theme);
            });
        });
    </script>
</body>
</html> 