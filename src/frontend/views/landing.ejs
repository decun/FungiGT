    <!-- Three.js Professional DNA Helix Animation Script -->
    <script>
        // Three.js Scene Setup - Professional implementation
        let scene, camera, renderer, dnaHelix, postEffect;
        let renderTarget, scenePE, cameraPE;
        let clock, resolution;

        // Math utility functions
        const MathEx = {
            radians: (degrees) => degrees * Math.PI / 180,
            degrees: (radians) => radians * 180 / Math.PI
        };

        // Debounce function
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // DNA Helix Class - Based on original implementation
        class DnaHelix extends THREE.Points {
            constructor() {
                // Define Geometry
                const geometry = new THREE.BufferGeometry();

                // Define attributes - exact same as original
                const numHelix = 6000;
                const numLineSpace = 60;
                const numLine = 100;
                const numAmount = numHelix + numLineSpace * numLine;
                const baPositions = new THREE.BufferAttribute(new Float32Array(numAmount * 3), 3);
                const baRadians = new THREE.BufferAttribute(new Float32Array(numAmount), 1);
                const baRadiuses = new THREE.BufferAttribute(new Float32Array(numAmount), 1);
                const baDelays = new THREE.BufferAttribute(new Float32Array(numAmount), 1);

                // Create helix particles
                for (var i = 0; i < numHelix; i++) {
                    const random = Math.random();
                    const diff = {
                        x: (Math.random() * 2 - 1) * random * 6,
                        y: (Math.random() * 2 - 1) * random * 6,
                        z: (Math.random() * 2 - 1) * random * 6,
                    };
                    baPositions.setXYZ(
                        i,
                        ((i / numHelix) * 2 - 1) * 150 + diff.x,
                        diff.y,
                        diff.z
                    );
                    baRadians.setX(i, MathEx.radians(i / numHelix * 900 + i % 2 * 180));
                    baRadiuses.setX(i, 18);
                    baDelays.setX(i, MathEx.radians(Math.random() * 360));
                }

                // Create connecting lines
                for (var j = 0; j < numLineSpace; j++) {
                    const radians = MathEx.radians(j / numLineSpace * 900);
                    for (var k = 0; k < numLine; k++) {
                        const index = j * numLine + k + numHelix;
                        const random = Math.random();
                        const diff = {
                            x: (Math.random() * 2 - 1) * random * 1,
                            y: (Math.random() * 2 - 1) * random * 1,
                            z: (Math.random() * 2 - 1) * random * 1,
                        };
                        baPositions.setXYZ(
                            index,
                            ((j / numLineSpace) * 2 - 1) * 150 + diff.x,
                            diff.y,
                            diff.z
                        );
                        baRadians.setX(index, radians);
                        baRadiuses.setX(index, (k / numLine * 2 - 1) * 18);
                        baDelays.setX(index, MathEx.radians(Math.random() * 360));
                    }
                }

                geometry.setAttribute('position', baPositions);
                geometry.setAttribute('radian', baRadians);
                geometry.setAttribute('radius', baRadiuses);
                geometry.setAttribute('delay', baDelays);

                // Define Material with original shaders
                const material = new THREE.RawShaderMaterial({
                    uniforms: {
                        time: { type: 'f', value: 0 },
                        projectionMatrix: { value: new THREE.Matrix4() },
                        viewMatrix: { value: new THREE.Matrix4() },
                        modelMatrix: { value: new THREE.Matrix4() }
                    },
                    vertexShader: `
                        attribute vec3 position;
                        attribute float radian;
                        attribute float radius;
                        attribute float delay;

                        uniform mat4 projectionMatrix;
                        uniform mat4 viewMatrix;
                        uniform mat4 modelMatrix;
                        uniform float time;

                        varying vec3 vColor;

                        void main() {
                            // coordinate transformation - exact original formula
                            vec3 updatePosition = position
                                + vec3(
                                    sin(time * 4.0 + delay),
                                    sin(radian + time * 0.4) * (radius + sin(time * 4.0 + delay)),
                                    cos(radian + time * 0.4) * (radius + sin(time * 4.0 + delay))
                                );
                            vec4 mvPosition = viewMatrix * modelMatrix * vec4(updatePosition, 1.0);
                            float distanceFromCamera = length(mvPosition.xyz);
                            float pointSize = 1000.0 / distanceFromCamera * 1.6;

                            // Elegant color palette for genomic theme
                            float variation = sin(delay * 2.5 + time * 0.3) * 0.5 + 0.5;
                            float helixPos = sin(radian + time * 0.2) * 0.5 + 0.5;
                            
                            vec3 color1 = vec3(0.2, 0.5, 0.9);  // Scientific blue
                            vec3 color2 = vec3(0.1, 0.7, 0.4);  // Genomic green  
                            vec3 color3 = vec3(0.6, 0.3, 0.8);  // Biotech purple
                            
                            vColor = mix(
                                mix(color1, color2, variation),
                                color3,
                                helixPos * 0.3
                            );
                            vColor *= 0.5; // Subtle intensity for readability

                            gl_Position = projectionMatrix * mvPosition;
                            gl_PointSize = pointSize;
                        }
                    `,
                    fragmentShader: `
                        precision highp float;
                        varying vec3 vColor;

                        void main() {
                            // Convert PointCoord to the other vec2 has a range from -1.0 to 1.0.
                            vec2 p = gl_PointCoord * 2.0 - 1.0;

                            // Draw circle - exact original formula
                            float radius = length(p);
                            float opacity1 = (1.0 - smoothstep(0.5, 0.7, radius));
                            float opacity2 = smoothstep(0.8, 1.0, radius) * (1.0 - smoothstep(1.0, 1.2, radius));

                            // Reduce opacity for better text readability
                            float finalOpacity = (opacity1 + opacity2) * 0.25;
                            gl_FragColor = vec4(vColor, finalOpacity);
                        }
                    `,
                    transparent: true,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false,
                });

                super(geometry, material);
                this.name = 'DNA Helix';
            }

            render(time) {
                this.material.uniforms.time.value += time;
                this.material.uniforms.projectionMatrix.value.copy(camera.projectionMatrix);
                this.material.uniforms.viewMatrix.value.copy(camera.matrixWorldInverse);
                this.material.uniforms.modelMatrix.value.copy(this.matrixWorld);
            }
        }

        // PostEffect Class - Based on original implementation
        class PostEffect {
            constructor(texture) {
                this.uniforms = {
                    time: { type: 'f', value: 0 },
                    texture: { type: 't', value: texture },
                    resolution: { type: 'v2', value: new THREE.Vector2() }
                };
                this.obj = null;
            }

            createObj() {
                const geometry = new THREE.PlaneGeometry(2, 2);
                const material = new THREE.RawShaderMaterial({
                    uniforms: this.uniforms,
                    vertexShader: `
                        attribute vec3 position;
                        attribute vec2 uv;
                        varying vec2 vUv;

                        void main() {
                            vUv = uv;
                            gl_Position = vec4(position, 1.0);
                        }
                    `,
                    fragmentShader: `
                        precision highp float;
                        uniform float time;
                        uniform sampler2D texture;
                        uniform vec2 resolution;
                        varying vec2 vUv;

                        float random2(vec2 c){
                            return fract(sin(dot(c.xy ,vec2(12.9898,78.233))) * 43758.5453);
                        }
                        float randomNoise(vec2 p) {
                            return (random2(p - vec2(sin(time))) * 2.0 - 1.0) * 0.015;
                        }

                        void main() {
                            // Convert uv to the other vec2 has a range from -1.0 to 1.0.
                            vec2 p = vUv * 2.0 - 1.0;
                            vec2 ratio = 1.0 / resolution;

                            // Random Noise
                            float rNoise = randomNoise(vUv);

                            // Subtle RGB Shift for better readability
                            float shift = 0.5; // Reduced shift intensity
                            float texColorR = texture2D(texture, vUv - vec2((shift * abs(p.x) + 0.5) * ratio.x, 0.0)).r;
                            float texColorG = texture2D(texture, vUv + vec2((shift * abs(p.x) + 0.5) * ratio.x, 0.0)).g;
                            float texColorB = texture2D(texture, vUv).b;

                            // Sum total of colors.
                            vec3 color = vec3(texColorR, texColorG, texColorB) + rNoise;

                            gl_FragColor = vec4(vec3(texColorR, texColorG, texColorB) + rNoise, 1.0);
                        }
                    `
                });

                this.obj = new THREE.Mesh(geometry, material);
                this.obj.name = 'PostEffect';
            }

            resize(x, y) {
                this.uniforms.resolution.value.set(x, y);
            }

            render(time) {
                this.uniforms.time.value += time;
            }
        }

        function init() {
            // Create resolution vector
            resolution = new THREE.Vector2();
            
            // Create main scene
            scene = new THREE.Scene();
            
            // Create camera with exact original settings
            camera = new THREE.PerspectiveCamera();
            camera.aspect = 3 / 2;
            camera.far = 1000;
            camera.position.set(-110, -75, 45);
            camera.lookAt(new THREE.Vector3(0, 0, 0));
            
            // Create renderer
            renderer = new THREE.WebGL1Renderer({ 
                alpha: true, 
                antialias: true 
            });
            renderer.setClearColor(0x000000, 0.3);
            document.getElementById('canvas-container').appendChild(renderer.domElement);
            
            // Create clock
            clock = new THREE.Clock({ autoStart: false });
            
            // Setup post-processing
            renderTarget = new THREE.WebGLRenderTarget();
            scenePE = new THREE.Scene();
            cameraPE = new THREE.OrthographicCamera(-1, 1, 1, -1, 1, 2);
            
            // Create DNA helix
            dnaHelix = new DnaHelix();
            scene.add(dnaHelix);
            
            // Create post effect
            postEffect = new PostEffect(renderTarget.texture);
            postEffect.createObj();
            scenePE.add(postEffect.obj);
            
            // Add event listeners
            setupEventListeners();
            
            // Initialize and start
            resizeWindow();
            clock.start();
            renderLoop();
        }



        function resizeCamera() {
            camera.setFocalLength(50);
            camera.setViewOffset(
                1200,
                800,
                (resolution.x - 1200) / -2,
                (resolution.y - 800) / -2,
                resolution.x,
                resolution.y
            );
            camera.updateProjectionMatrix();
        }

        function resizeWindow() {
            resolution.set(window.innerWidth, window.innerHeight);
            renderer.domElement.width = resolution.x;
            renderer.domElement.height = resolution.y;
            resizeCamera();
            renderer.setSize(resolution.x, resolution.y);
            renderTarget.setSize(resolution.x, resolution.y);
            postEffect.resize(resolution.x, resolution.y);
        }

        function setupEventListeners() {
            // Window focus/blur for performance
            window.addEventListener('blur', () => {
                clock.stop();
            });
            window.addEventListener('focus', () => {
                clock.start();
            });
            
            // Window resize with debounce
            window.addEventListener('resize', debounce(resizeWindow, 1000));
        }

        function render() {
            const time = clock.getDelta();
            
            // Update DNA helix - exact original method
            dnaHelix.render(time);
            
            // Render main scene to frame buffer
            renderer.setRenderTarget(renderTarget);
            renderer.render(scene, camera);
            
            // Render post effect
            postEffect.render(time);
            renderer.setRenderTarget(null);
            renderer.render(scenePE, cameraPE);
        }

        function renderLoop() {
            render();
            requestAnimationFrame(renderLoop);
        }

        // Initialize when page loads
        window.addEventListener('load', init);

        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
</html>