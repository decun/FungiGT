        // Configurar controles de gráficos
        function setupGraphControls(graphs) {
            const selector = document.getElementById('graphSelector');
            const currentImage = document.getElementById('currentGraphImage');
            const graphTitle = document.getElementById('graphTitle');
            const drFungitoBtn = document.getElementById('drFungitoAnalyzeBtn');
            const zoomInBtn = document.getElementById('zoomInBtn');
            const zoomOutBtn = document.getElementById('zoomOutBtn');
            const fullscreenBtn = document.getElementById('fullscreenBtn');
            const downloadBtn = document.getElementById('downloadBtn');
            
            let currentScale = 1;
            let isDragging = false;
            let dragStartX, dragStartY, initialTransformX = 0, initialTransformY = 0;
            
            // Cambiar gráfico
            selector.addEventListener('change', function() {
                const selectedIndex = parseInt(this.value);
                const selectedGraph = graphs[selectedIndex];
                currentImage.src = selectedGraph;
                graphTitle.textContent = getGraphTitle(selectedGraph);
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
            
            // Zoom in
            zoomInBtn.addEventListener('click', function() {
                currentScale = Math.min(currentScale * 1.2, 3);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Zoom out  
            zoomOutBtn.addEventListener('click', function() {
                currentScale = Math.max(currentScale / 1.2, 0.5);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Pantalla completa
            fullscreenBtn.addEventListener('click', function() {
                if (currentImage.requestFullscreen) {
                    currentImage.requestFullscreen();
                } else if (currentImage.webkitRequestFullscreen) {
                    currentImage.webkitRequestFullscreen();
                } else if (currentImage.mozRequestFullScreen) {
                    currentImage.mozRequestFullScreen();
                }
            });
            
            // Descargar
            downloadBtn.addEventListener('click', function() {
                const link = document.createElement('a');
                link.href = currentImage.src;
                link.download = currentImage.src.split('/').pop();
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
            
            // Dr. Fungito análisis
            drFungitoBtn.addEventListener('click', function() {
                showNotification('Dr. Fungito', 'Función de análisis con Dr. Fungito en desarrollo', 'info');
            });
            
            // Drag para mover imagen
            currentImage.addEventListener('mousedown', function(e) {
                if (currentScale > 1) {
                    isDragging = true;
                    dragStartX = e.clientX;
                    dragStartY = e.clientY;
                    currentImage.style.cursor = 'grabbing';
                }
            });
            
            document.addEventListener('mousemove', function(e) {
                if (isDragging && currentScale > 1) {
                    const deltaX = e.clientX - dragStartX;
                    const deltaY = e.clientY - dragStartY;
                    currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX + deltaX/currentScale}px, ${initialTransformY + deltaY/currentScale}px)`;
                }
            });
            
            document.addEventListener('mouseup', function() {
                if (isDragging) {
                    isDragging = false;
                    currentImage.style.cursor = 'grab';
                    const transform = currentImage.style.transform;
                    const translateMatch = transform.match(/translate\(([^,]+)px,\s*([^)]+)px\)/);
                    if (translateMatch) {
                        initialTransformX = parseFloat(translateMatch[1]);
                        initialTransformY = parseFloat(translateMatch[2]);
                    }
                }
            });
            
            // Reset posición con doble click
            currentImage.addEventListener('dblclick', function() {
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
        }

        // Obtener título del gráfico
        function getGraphTitle(graphUrl) {
            const filename = graphUrl.split('/').pop().replace('.png', '');
            const titles = {
                'distance_heatmap': '🔥 Mapa de Calor - Distancias',
                'ani_heatmap': '🔥 Mapa de Calor - ANI', 
                'correlation_heatmap': '🔥 Mapa de Calor - Correlaciones',
                'dendrogram_simple': '🌳 Dendrograma Simple',
                'distance_distributions': '📊 Distribución de Distancias',
                'scatter_analysis': '📈 Análisis de Dispersión',
                'mds_analysis': '🗺️ Análisis Multidimensional'
            };
            
            for (const [key, title] of Object.entries(titles)) {
                if (filename.includes(key)) {
                    return title;
                }
            }
            
            return '📊 Gráfico de Análisis';
        }

        // ===== FUNCIONES PARA VISUALIZADOR EGGNOG =====

        // Configurar drag and drop para EggNOG
        function setupEggnogDragDrop() {
            const dropZone = document.getElementById('eggnogDropZone');
            const fileInput = document.getElementById('eggnogFileInput');
            const processBtn = document.getElementById('processEggnogBtn');

            if (!dropZone || !fileInput || !processBtn) return;

            // Eventos del drop zone
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', handleEggnogDragOver);
            dropZone.addEventListener('drop', handleEggnogDrop);
            dropZone.addEventListener('dragleave', handleEggnogDragLeave);

            // Evento del input de archivo
            fileInput.addEventListener('change', handleEggnogFileSelect);

            // Evento del botón de procesar
            processBtn.addEventListener('click', processEggnogFile);
        }

        // Verificar si un archivo es compatible para EggNOG
        function isEggNOGFile(fileName) {
            const lowerName = fileName.toLowerCase();
            return lowerName.includes('.emapper.annotations') || 
                   lowerName.includes('.emapper.seed_orthologs') ||
                   lowerName.includes('.emapper.hits') ||
                   lowerName.endsWith('.annotations') ||
                   lowerName.endsWith('.seed_orthologs') ||
                   lowerName.endsWith('.hits') ||
                   lowerName.includes('eggnog') ||
                   (lowerName.endsWith('.tsv') && (lowerName.includes('annot') || lowerName.includes('seed') || lowerName.includes('hits'))) ||
                   (lowerName.endsWith('.txt') && (lowerName.includes('annot') || lowerName.includes('seed') || lowerName.includes('hits')));
        }
        
        // Detectar tipo específico de archivo EggNOG
        function getEggNOGFileType(fileName) {
            const lowerName = fileName.toLowerCase();
            if (lowerName.includes('seed_orthologs') || lowerName.includes('seed-orthologs')) {
                return 'seed_orthologs';
            } else if (lowerName.includes('hits')) {
                return 'hits';
            } else if (lowerName.includes('annotations') || lowerName.includes('annot')) {
                return 'annotations';
            }
            return 'annotations'; // Por defecto
        }

        // Manejar drag over para EggNOG
        function handleEggnogDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        // Manejar drag leave para EggNOG
        function handleEggnogDragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        // Manejar drop para EggNOG
        function handleEggnogDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            
            // Intentar obtener datos del file explorer
            try {
                const dragData = e.dataTransfer.getData('text/plain');
                if (dragData) {
                    const fileData = JSON.parse(dragData);
                    if (fileData.fileName && fileData.filePath && !fileData.isDirectory) {
                        if (isEggNOGFile(fileData.fileName)) {
                            selectEggnogFileFromExplorer(fileData.fileName, fileData.filePath);
                        } else {
                            showNotification('Archivo no compatible', 
                                `El archivo "${fileData.fileName}" no es compatible con EggNOG. Formatos soportados: .emapper.annotations, .emapper.seed_orthologs, .emapper.hits`, 
                                'warning');
                        }
                        return;
                    }
                }
            } catch (error) {
                console.log('No hay datos del file explorer, intentando con archivos locales');
            }
            
            // Si no hay datos del file explorer, usar archivos locales
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (isEggNOGFile(file.name)) {
                    handleEggnogFileSelect({ target: { files: files } });
                } else {
                    showNotification('Archivo no compatible', 
                        `El archivo "${file.name}" no es compatible con EggNOG. Formatos soportados: .emapper.annotations, .emapper.seed_orthologs, .emapper.hits`, 
                        'warning');
                }
            }
        }

        // Seleccionar archivo EggNOG desde el explorador
        function selectEggnogFileFromExplorer(fileName, filePath) {
            currentSelectedFile = { name: fileName };
            currentSelectedFilePath = filePath;
            
            const fileType = getEggNOGFileType(fileName);
            const typeNames = {
                'seed_orthologs': 'Seed Orthologs',
                'hits': 'Hits',
                'annotations': 'Anotaciones'
            };
            
            // Mostrar información del archivo
            document.getElementById('selectedEggnogFileName').textContent = fileName;
            document.getElementById('selectedEggnogFilePath').textContent = filePath;
            document.getElementById('selectedEggnogFileType').textContent = `Tipo: ${typeNames[fileType]}`;
            document.getElementById('selectedEggnogFileInfo').style.display = 'block';
            
            // Habilitar botón de procesar
            document.getElementById('processEggnogBtn').disabled = false;
            
            // Cambiar al visualizador EggNOG si no está seleccionado
            const selector = document.getElementById('visualizerSelector');
            if (selector.value !== 'eggnog') {
                selector.value = 'eggnog';
                selector.dispatchEvent(new Event('change'));
            }

            showNotification('Archivo EggNOG seleccionado', 
                `Se ha seleccionado el archivo: ${fileName} (${typeNames[fileType]})`, 'success');
        }

        // Manejar selección de archivo EggNOG
        function handleEggnogFileSelect(e) {
            const file = e.target.files[0];
            if (file) {
                currentSelectedFile = file;
                currentSelectedFilePath = null;
                
                const fileType = getEggNOGFileType(file.name);
                const typeNames = {
                    'seed_orthologs': 'Seed Orthologs',
                    'hits': 'Hits',
                    'annotations': 'Anotaciones'
                };
                
                document.getElementById('selectedEggnogFileName').textContent = file.name;
                document.getElementById('selectedEggnogFilePath').textContent = 'Archivo local';
                document.getElementById('selectedEggnogFileType').textContent = `Tipo: ${typeNames[fileType]}`;
                document.getElementById('selectedEggnogFileInfo').style.display = 'block';
                
                document.getElementById('processEggnogBtn').disabled = false;

                showNotification('Archivo EggNOG cargado', 
                    `Se ha cargado el archivo: ${file.name} (${typeNames[fileType]})`, 'success');
            }
        }

        // Procesar archivo EggNOG
        async function processEggnogFile() {
            const statusElement = document.getElementById('eggnogStatus');
            const graphsContainer = document.getElementById('eggnogGraphsContainer');
            const statsPanel = document.getElementById('eggnogStatsPanel');
            
            const fileName = currentSelectedFile?.name || currentSelectedFilePath?.split('/').pop() || '';
            const fileType = getEggNOGFileType(fileName);
            
            // Limpiar contenido anterior
            graphsContainer.innerHTML = '';
            statsPanel.style.display = 'none';
            
            const typeNames = {
                'seed_orthologs': 'Seed Orthologs',
                'hits': 'Hits',
                'annotations': 'Anotaciones'
            };
            statusElement.innerHTML = `<div class="loading-spinner"></div> Procesando archivo EggNOG (${typeNames[fileType]})...`;
            statusElement.className = 'mb-6 text-sm text-blue-600';
            
            try {
                const formData = new FormData();
                
                if (currentSelectedFilePath) {
                    // Archivo del servidor - usar la nueva ruta simple
                    formData.append('filePath', currentSelectedFilePath);
                    formData.append('file_type', fileType);
                } else if (currentSelectedFile) {
                    // Archivo local
                    formData.append('file', currentSelectedFile);
                    formData.append('file_type', fileType);
                } else {
                    throw new Error('No hay archivo seleccionado');
                }
                
                const response = await fetch(`${bindashVisualizerUrl}/process-eggnog`, {
                    method: 'POST',
                    body: formData
                });
                
                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status}`);
                }
                
                const data = await response.json();
                console.log('Resultado EggNOG:', data);
                statusElement.textContent = `✅ Archivo procesado exitosamente (${data.graphs?.length || 0} gráficos generados)`;
                statusElement.className = 'mb-6 text-sm text-green-600';
                
                // Mostrar estadísticas
                if (data.stats) {
                    displayEggnogStats(data.stats, fileType);
                }
                
                // Mostrar gráficos
                if (data.graphs && data.graphs.length > 0) {
                    displayEggnogGraphs(data.graphs);
                }

                showNotification('Procesamiento completado', 
                    `El archivo EggNOG (${typeNames[fileType]}) ha sido procesado exitosamente`, 'success');
                
            } catch (error) {
                console.error('Error procesando archivo EggNOG:', error);
                statusElement.textContent = `❌ Error: ${error.message}`;
                statusElement.className = 'mb-6 text-sm text-red-600';
                showNotification('Error de procesamiento', error.message, 'error');
            }
        }

