<%- include('partials/header') %>

<head>
    <!-- SweetAlert2 para modales de ayuda -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Load IGV library and styles properly -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/igv@2.15.11/dist/igv.min.css">
    <script src="https://cdn.jsdelivr.net/npm/igv@2.15.11/dist/igv.min.js"></script>
    <style>
        .glass-effect {
            background: rgba(167, 243, 208, 0.2);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        
        .nav-item-hover:hover {
            background: rgba(167, 243, 208, 0.3);
            transform: translateY(-2px);
        }
        
        /* Estilo para los contenedores de visualizadores */
        .visualizer .bg-white {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(167, 243, 208, 0.3);
        }
        
        /* Estilo para los botones secundarios */
        .secondary-btn {
            @apply flex items-center space-x-2 px-4 py-2 rounded-lg glass-effect nav-item-hover transition-all duration-300 text-gray-800 font-medium;
        }
        
        /* Estilo para los inputs y selects */
        input[type="text"], select {
            @apply border-green-200 focus:ring-green-300 focus:border-green-300;
        }

        /* Estilos para el visualizador de gráficos */
        .graph-viewer {
            position: relative;
            width: 100%;
            height: 600px;
            overflow: hidden;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            background: #f9fafb;
        }

        .graph-image {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.2s ease;
            cursor: grab;
        }

        .graph-image:active {
            cursor: grabbing;
        }

        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Estilos para drag and drop */
        .drag-over {
            background-color: #e6f7ff !important;
            border: 2px dashed #1890ff !important;
            transform: scale(1.02);
            box-shadow: 0 8px 25px rgba(24, 144, 255, 0.15);
        }

        .dragging {
            opacity: 0.5;
        }

        .drop-zone {
            border: 2px dashed #d9d9d9;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            background-color: #fafafa;
            transition: all 0.3s ease;
            position: relative;
        }

        .drop-zone.drag-over {
            border-color: #1890ff;
            background-color: #e6f7ff;
            transform: scale(1.02);
            box-shadow: 0 8px 25px rgba(24, 144, 255, 0.15);
        }

        .drop-zone.drag-over::after {
            content: "📁 Suelta el archivo aquí";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(24, 144, 255, 0.9);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            pointer-events: none;
            z-index: 10;
        }

        .file-item {
            cursor: move;
            transition: all 0.2s ease;
        }

        .file-item:hover {
            background-color: #f0f8ff;
        }
    </style>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">
    <main class="flex-grow p-6">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row gap-6">
                <!-- Panel lateral: Explorador de archivos -->
                <div class="w-full md:w-1/3 lg:w-1/4">
                    <%- include('partials/file-explorer') %>
                </div>
                
                <!-- Panel principal -->
                <div class="w-full md:w-2/3 lg:w-3/4">
                    <h2 class="text-3xl font-bold mb-8 flex items-center text-gray-800">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                        Visualizador de Datos Genómicos
                    </h2>

                    <!-- Selector para elegir visualizador -->
                    <div class="bg-white p-6 rounded-xl shadow-lg mb-8 border border-gray-200">
                        <h3 class="text-xl font-semibold mb-4 flex items-center text-gray-800">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4" />
                            </svg>
                            Seleccionar Tipo de Visualización
                        </h3>
                        <div class="mt-4">
                            <label class="block text-sm font-medium text-gray-700 mb-3">
                                Elige el tipo de visualización que deseas utilizar:
                            </label>
                            <select id="visualizerSelector" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                                <option value="">Seleccione un visualizador</option>
                                <option value="bindash">BinDash - Análisis de Similitud Genómica</option>
                                <option value="eggnog">🧬 EggNOG - Annotations, Seed Orthologs, Hits</option>
                                <option value="checkm">🔬 CheckM - Control de Calidad de Genomas</option>
                            </select>
                        </div>
                    </div>

                    <!-- Visualizador BinDash (principal) -->
                    <div id="bindashVisualizerSection" class="bg-white p-8 rounded-xl shadow-lg mb-8 border border-gray-200" style="display: none;">
                        <div class="border-l-4 border-green-500 pl-6 mb-6">
                            <h3 class="text-2xl font-semibold mb-2 flex items-center text-gray-800">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-3 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                Visualizador BinDash
                            </h3>
                            <p class="text-gray-600 text-sm">Arrastra archivos desde el explorador de archivos o sube un archivo para visualizar análisis de similitud genómica</p>
                        </div>

                        <!-- Zona de drop para archivos -->
                        <div id="bindashDropZone" class="drop-zone mb-6 cursor-pointer">
                            <div class="text-center py-8">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                                <p class="text-lg font-medium text-gray-700 mb-2">Arrastra archivos aquí</p>
                                <p class="text-sm text-gray-500 mb-4">o haz clic para seleccionar archivos</p>
                                <p class="text-xs text-gray-400">Archivos soportados: .txt, .tsv, .csv</p>
                            </div>
                        </div>

                        <!-- Input oculto para archivos -->
                        <input type="file" id="bindashFileInput" accept=".txt,.tsv,.csv" style="display: none;">

                        <!-- Información del archivo seleccionado -->
                        <div id="selectedFileInfo" class="bg-blue-50 p-4 rounded-lg border border-blue-200 mb-6" style="display: none;">
                            <h4 class="font-semibold text-blue-800 mb-2">📁 Archivo seleccionado:</h4>
                            <p id="selectedFileName" class="text-blue-700 text-sm font-medium"></p>
                            <p id="selectedFilePath" class="text-blue-600 text-xs mt-1"></p>
                        </div>

                        <!-- Botón de procesar -->
                        <div class="mb-6">
                            <button id="processBindashBtn" class="w-full bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                Procesar Archivo con BinDash
                            </button>
                        </div>

                        <!-- Estado del procesamiento -->
                        <div id="bindashStatus" class="mb-6 text-sm text-gray-600"></div>

                        <!-- Estadísticas del análisis -->
                        <div id="bindashStatsPanel" class="bg-gradient-to-r from-blue-50 to-purple-50 p-6 rounded-lg border border-blue-200 mb-6" style="display: none;">
                            <h4 class="text-lg font-semibold mb-4 text-gray-800">📊 Estadísticas del Análisis</h4>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-blue-600" id="totalComparisons">0</div>
                                    <div class="text-sm text-gray-600">Comparaciones</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-green-600" id="uniqueGenomes">0</div>
                                    <div class="text-sm text-gray-600">Genomas únicos</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-purple-600" id="meanANI">0</div>
                                    <div class="text-sm text-gray-600">Jaccard promedio</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-orange-600" id="meanDistance">0</div>
                                    <div class="text-sm text-gray-600">Distancia promedio</div>
                                </div>
                            </div>
                        </div>

                        <!-- Contenedor para gráficos -->
                        <div id="bindashGraphsContainer" class="mt-6"></div>
                    </div>



                    <!-- Visualizador EggNOG -->
                    <div id="eggnogVisualizerSection" class="bg-white p-8 rounded-xl shadow-lg mb-8 border border-gray-200" style="display: none;">
                        <div class="border-l-4 border-orange-500 pl-6 mb-6">
                            <h3 class="text-2xl font-semibold mb-2 flex items-center text-gray-800">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-3 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                Visualizador EggNOG
                            </h3>
                            <p class="text-gray-600 text-sm">Procesamiento de archivos EggNOG-mapper: Annotations, Seed Orthologs y Hits</p>
                        </div>

                        <!-- Zona de drop para archivos -->
                        <div id="eggnogDropZone" class="drop-zone mb-6 cursor-pointer">
                            <div class="text-center py-8">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                                <p class="text-lg font-medium text-gray-700 mb-2">Arrastra archivos EggNOG aquí</p>
                                <p class="text-sm text-gray-500 mb-4">o haz clic para seleccionar archivos</p>
                                <p class="text-xs text-gray-400">Archivos soportados: .emapper.annotations, .emapper.seed_orthologs, .emapper.hits</p>
                            </div>
                        </div>

                        <!-- Input oculto para archivos -->
                        <input type="file" id="eggnogFileInput" accept=".annotations,.emapper.annotations,.seed_orthologs,.emapper.seed_orthologs,.hits,.emapper.hits,.tsv,.txt" style="display: none;">

                        <!-- Información del archivo seleccionado -->
                        <div id="selectedEggnogFileInfo" class="bg-orange-50 p-4 rounded-lg border border-orange-200 mb-6" style="display: none;">
                            <h4 class="font-semibold text-orange-800 mb-2">📁 Archivo EggNOG seleccionado:</h4>
                            <p id="selectedEggnogFileName" class="text-orange-700 text-sm font-medium"></p>
                            <p id="selectedEggnogFilePath" class="text-orange-600 text-xs mt-1"></p>
                            <p id="selectedEggnogFileType" class="text-orange-600 text-xs mt-1 font-medium"></p>
                        </div>

                        <!-- Botón de procesar -->
                        <div class="mb-6">
                            <button id="processEggnogBtn" class="w-full bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                                Procesar Archivo EggNOG
                            </button>
                        </div>
                        
                        <!-- Estado del procesamiento -->
                        <div id="eggnogStatus" class="mb-6 text-sm text-gray-600"></div>

                        <!-- Estadísticas del análisis -->
                        <div id="eggnogStatsPanel" class="bg-gradient-to-r from-orange-50 to-red-50 p-6 rounded-lg border border-orange-200 mb-6" style="display: none;">
                            <h4 class="text-lg font-semibold mb-4 text-gray-800">📊 Estadísticas EggNOG</h4>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-blue-600" id="totalEggnogRecords">0</div>
                                    <div class="text-sm text-gray-600">Total registros</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-green-600" id="uniqueEggnogQueries">0</div>
                                    <div class="text-sm text-gray-600">Queries únicas</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-purple-600" id="eggnogFileTypeDisplay">-</div>
                                    <div class="text-sm text-gray-600">Tipo de archivo</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-orange-600" id="eggnogCoverage">0%</div>
                                    <div class="text-sm text-gray-600">Cobertura</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Contenedor para gráficos -->
                        <div id="eggnogGraphsContainer" class="mt-6"></div>
                    </div>

                    <!-- Visualizador CheckM -->
                    <div id="checkmVisualizerSection" class="bg-white p-8 rounded-xl shadow-lg mb-8 border border-gray-200" style="display: none;">
                        <div class="border-l-4 border-blue-500 pl-6 mb-6">
                            <h3 class="text-2xl font-semibold mb-2 flex items-center text-gray-800">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-3 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                Visualizador CheckM
                            </h3>
                            <p class="text-gray-600 text-sm">Análisis de control de calidad de genomas: lineage, bins stats, archivos .fna y más</p>
                        </div>

                        <!-- Información de detección automática -->
                        <div class="mb-6 p-4 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg border border-green-200">
                            <h4 class="font-semibold text-green-800 mb-2">🤖 Detección Automática</h4>
                            <p class="text-sm text-green-700">El tipo de análisis se detecta automáticamente basado en el nombre y contenido del archivo.</p>
                            <div class="mt-3 text-xs text-green-600">
                                <p><strong>Formatos soportados:</strong></p>
                                <p>• CheckM: lineage_ms, bins_stats, qa_results</p>
                                <p>• HMMER: .analyze, .tree (hmmer.analyze, hmmer.tree)</p>
                                <p>• Secuencias: .fna, .fasta, .fa</p>
                                <p>• Árboles: .tree, .nwk</p>
                            </div>
                        </div>

                        <!-- Zona de drop para archivos -->
                        <div id="checkmDropZone" class="drop-zone mb-6 cursor-pointer">
                            <div class="text-center py-8">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                </svg>
                                <p class="text-lg font-medium text-gray-700 mb-2">Arrastra archivos CheckM aquí</p>
                                <p class="text-sm text-gray-500 mb-4">o haz clic para seleccionar archivos</p>
                                <div class="text-xs text-gray-400 space-y-1">
                                    <p><strong>Formatos soportados:</strong></p>
                                    <p>• .tsv, .txt (lineage_ms, bins_stats, qa_results)</p>
                                    <p>• .fna, .fasta, .fa (secuencias genómicas)</p>
                                    <p>• .tree, .nwk (árboles filogenéticos)</p>
                                    <p>• Cualquier salida de CheckM</p>
                                </div>
                            </div>
                        </div>

                        <!-- Input oculto para archivos -->
                        <input type="file" id="checkmFileInput" accept=".tsv,.txt,.fna,.fasta,.fa,.tree,.nwk,.csv" style="display: none;">

                        <!-- Información del archivo seleccionado -->
                        <div id="selectedCheckmFileInfo" class="bg-blue-50 p-4 rounded-lg border border-blue-200 mb-6" style="display: none;">
                            <h4 class="font-semibold text-blue-800 mb-2">📁 Archivo CheckM seleccionado:</h4>
                            <p id="selectedCheckmFileName" class="text-blue-700 text-sm font-medium"></p>
                            <p id="selectedCheckmFilePath" class="text-blue-600 text-xs mt-1"></p>
                            <p id="selectedCheckmFileType" class="text-green-700 text-xs mt-1 font-medium">🤖 Tipo detectado automáticamente</p>
                            <p id="selectedCheckmAnalysisInfo" class="text-blue-600 text-xs mt-1"></p>
                        </div>

                        <!-- Opciones adicionales para análisis FNA -->
                        <div id="fnaAnalysisOptions" class="bg-green-50 p-4 rounded-lg border border-green-200 mb-6" style="display: none;">
                            <h4 class="font-semibold text-green-800 mb-3">🧬 Opciones de Análisis BioPython</h4>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                                <label class="flex items-center space-x-2">
                                    <input type="checkbox" id="basicStats" checked class="text-green-600">
                                    <span class="text-sm">Estadísticas básicas</span>
                                </label>
                                <label class="flex items-center space-x-2">
                                    <input type="checkbox" id="gcContent" checked class="text-green-600">
                                    <span class="text-sm">Contenido GC</span>
                                </label>
                                <label class="flex items-center space-x-2">
                                    <input type="checkbox" id="n50Stats" checked class="text-green-600">
                                    <span class="text-sm">N50/N90</span>
                                </label>
                                <label class="flex items-center space-x-2">
                                    <input type="checkbox" id="lengthDistribution" checked class="text-green-600">
                                    <span class="text-sm">Distribución de longitudes</span>
                                </label>
                                <label class="flex items-center space-x-2">
                                    <input type="checkbox" id="codonUsage" class="text-green-600">
                                    <span class="text-sm">Uso de codones</span>
                                </label>
                                <label class="flex items-center space-x-2">
                                    <input type="checkbox" id="orfPrediction" class="text-green-600">
                                    <span class="text-sm">Predicción ORF</span>
                                </label>
                            </div>
                        </div>

                        <!-- Botón de procesar -->
                        <div class="mb-6">
                            <button id="processCheckmBtn" class="w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors font-medium disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
