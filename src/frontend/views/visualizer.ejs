        // Procesar archivo CheckM
        async function processCheckmFile() {
            const statusElement = document.getElementById('checkmStatus');
            const graphsContainer = document.getElementById('checkmGraphsContainer');
            const statsPanel = document.getElementById('checkmStatsPanel');
            
            const fileName = currentSelectedFile?.name || currentSelectedFilePath?.split('/').pop() || '';
            const fileType = getCheckmFileType(fileName);
            
            // Limpiar contenido anterior
            graphsContainer.innerHTML = '';
            statsPanel.style.display = 'none';
            
            statusElement.innerHTML = `<div class="loading-spinner"></div> Procesando archivo CheckM (${fileType})...`;
            statusElement.className = 'mb-6 text-sm text-blue-600';
            
            try {
                const formData = new FormData();
                
                if (currentSelectedFilePath) {
                    // Archivo del servidor
                    formData.append('filePath', currentSelectedFilePath);
                } else if (currentSelectedFile) {
                    // Archivo local
                    formData.append('file', currentSelectedFile);
                } else {
                    throw new Error('No hay archivo seleccionado');
                }
                
                // Si es análisis FNA, agregar opciones de BioPython
                if (fileType === 'Análisis de secuencias FASTA') {
                    const options = {
                        basic_stats: document.getElementById('basicStats')?.checked || false,
                        gc_content: document.getElementById('gcContent')?.checked || false,
                        n50_stats: document.getElementById('n50Stats')?.checked || false,
                        length_distribution: document.getElementById('lengthDistribution')?.checked || false,
                        codon_usage: document.getElementById('codonUsage')?.checked || false,
                        orf_prediction: document.getElementById('orfPrediction')?.checked || false
                    };
                    formData.append('fna_options', JSON.stringify(options));
                }
                
                const response = await fetch(`${bindashVisualizerUrl}/process-checkm`, {
                    method: 'POST',
                    body: formData
                });
                
                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status}`);
                }
                
                const data = await response.json();
                console.log('Resultado CheckM:', data);
                statusElement.textContent = `✅ Archivo procesado exitosamente (${data.graphs?.length || 0} gráficos generados)`;
                statusElement.className = 'mb-6 text-sm text-green-600';
                
                // Mostrar estadísticas
                if (data.stats) {
                    displayCheckmStats(data.stats, fileType);
                }
                
                // Mostrar gráficos
                if (data.graphs && data.graphs.length > 0) {
                    displayCheckmGraphs(data.graphs);
                }

                showNotification('Procesamiento completado', 
                    `El archivo CheckM (${fileType}) ha sido procesado exitosamente`, 'success');
                
            } catch (error) {
                console.error('Error procesando archivo CheckM:', error);
                statusElement.textContent = `❌ Error: ${error.message}`;
                statusElement.className = 'mb-6 text-sm text-red-600';
                showNotification('Error de procesamiento', error.message, 'error');
            }
        }

        // Mostrar estadísticas CheckM
        function displayCheckmStats(stats, fileType) {
            const statsPanel = document.getElementById('checkmStatsPanel');
            
            // Estadísticas generales de CheckM
            document.getElementById('totalCheckmBins').textContent = stats.total_bins || stats.total_genomes || 'N/A';
            document.getElementById('highQualityBins').textContent = stats.high_quality || stats.complete_genomes || '0';
            document.getElementById('mediumQualityBins').textContent = stats.medium_quality || stats.near_complete || '0';
            document.getElementById('lowQualityBins').textContent = stats.low_quality || stats.contaminated || '0';
            
            // Estadísticas específicas para FNA
            if (fileType === 'Análisis de secuencias FASTA' && stats.fna_stats) {
                const fnaSection = document.getElementById('fnaStatsSection');
                document.getElementById('totalSequences').textContent = stats.fna_stats.total_sequences || '0';
                document.getElementById('totalLength').textContent = formatLength(stats.fna_stats.total_length) || '0';
                document.getElementById('averageGC').textContent = stats.fna_stats.average_gc ? `${stats.fna_stats.average_gc}%` : '0%';
                document.getElementById('n50Value').textContent = formatLength(stats.fna_stats.n50) || '0';
                fnaSection.style.display = 'block';
            } else {
                document.getElementById('fnaStatsSection').style.display = 'none';
            }
            
            statsPanel.style.display = 'block';
        }

        // Formatear longitud para mostrar
        function formatLength(length) {
            if (!length) return '0';
            if (length >= 1000000) {
                return (length / 1000000).toFixed(1) + 'M';
            } else if (length >= 1000) {
                return (length / 1000).toFixed(1) + 'K';
            }
            return length.toString();
        }

        // Mostrar gráficos CheckM
        function displayCheckmGraphs(graphs) {
            const container = document.getElementById('checkmGraphsContainer');
            
            // Corregir URLs
            const correctedGraphs = graphs.map(graphUrl => {
                if (graphUrl.startsWith('/graphs/')) {
                    return `${bindashVisualizerUrl}${graphUrl}`;
                }
                return graphUrl.replace('http://localhost:4005', bindashVisualizerUrl);
            });

            const selectorHTML = `
                <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <label class="font-medium text-gray-700">Seleccionar Gráfico:</label>
                        <select id="checkmGraphSelector" class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            ${correctedGraphs.map((graph, index) => 
                                `<option value="${index}" ${index === 0 ? 'selected' : ''}>${getCheckmGraphTitle(graph)}</option>`
                            ).join('')}
                        </select>
                    </div>
                    
                    <div class="relative bg-gray-50 rounded-lg border-2 border-gray-200">
                        <div class="absolute top-3 right-3 z-10 flex space-x-2">
                            <button id="checkmDrFungitoAnalyzeBtn" class="bg-green-500 bg-opacity-80 hover:bg-opacity-100 text-white p-2 rounded hover:scale-110 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-green-400" title="Analizar con Dr. Fungito IA">
                                <i class="fas fa-search text-sm"></i>
                            </button>
                            <button id="checkmZoomInBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all" title="Zoom In">
                                <i class="fas fa-search-plus text-sm"></i>
                            </button>
                            <button id="checkmZoomOutBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all" title="Zoom Out">
                                <i class="fas fa-search-minus text-sm"></i>
                            </button>
                            <button id="checkmFullscreenBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all" title="Pantalla completa">
                                <i class="fas fa-expand text-sm"></i>
                            </button>
                            <button id="checkmDownloadBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all" title="Descargar">
                                <i class="fas fa-download text-sm"></i>
                            </button>
                        </div>
                        
                        <div class="absolute top-3 left-3 z-10">
                            <h5 id="checkmGraphTitle" class="bg-white bg-opacity-90 px-3 py-1 rounded-md text-sm font-semibold text-gray-800 shadow-sm">
                                ${getCheckmGraphTitle(correctedGraphs[0])}
                            </h5>
                        </div>
                        
                        <div class="p-6 min-h-[500px] flex items-center justify-center">
                            <img id="currentCheckmGraphImage" 
                                 src="${correctedGraphs[0]}" 
                                 alt="Gráfico CheckM" 
                                 class="max-w-full max-h-[500px] object-contain rounded-lg shadow-lg transition-transform duration-200"
                                 style="cursor: grab;"
                                 onerror="this.src='data:image/svg+xml;base64,'; this.alt='Error cargando imagen';" />
                        </div>
                    </div>
                </div>
            `;
                
            container.innerHTML = selectorHTML;
            setupCheckmGraphControls(correctedGraphs);
        }

        // Configurar controles de gráficos CheckM
        function setupCheckmGraphControls(graphs) {
            const selector = document.getElementById('checkmGraphSelector');
            const currentImage = document.getElementById('currentCheckmGraphImage');
            const graphTitle = document.getElementById('checkmGraphTitle');
            const drFungitoBtn = document.getElementById('checkmDrFungitoAnalyzeBtn');
            const zoomInBtn = document.getElementById('checkmZoomInBtn');
            const zoomOutBtn = document.getElementById('checkmZoomOutBtn');
            const fullscreenBtn = document.getElementById('checkmFullscreenBtn');
            const downloadBtn = document.getElementById('checkmDownloadBtn');
            
            let currentScale = 1;
            let isDragging = false;
            let dragStartX, dragStartY, initialTransformX = 0, initialTransformY = 0;
            
            // Cambiar gráfico
            selector.addEventListener('change', function() {
                const selectedIndex = parseInt(this.value);
                const selectedGraph = graphs[selectedIndex];
                currentImage.src = selectedGraph;
                graphTitle.textContent = getCheckmGraphTitle(selectedGraph);
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
            
            // Zoom in
            zoomInBtn.addEventListener('click', function() {
                currentScale = Math.min(currentScale * 1.2, 3);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Zoom out  
            zoomOutBtn.addEventListener('click', function() {
                currentScale = Math.max(currentScale / 1.2, 0.5);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Pantalla completa
            fullscreenBtn.addEventListener('click', function() {
                if (currentImage.requestFullscreen) {
                    currentImage.requestFullscreen();
                } else if (currentImage.webkitRequestFullscreen) {
                    currentImage.webkitRequestFullscreen();
                } else if (currentImage.mozRequestFullScreen) {
                    currentImage.mozRequestFullScreen();
                }
            });
            
            // Descargar
            downloadBtn.addEventListener('click', function() {
                const link = document.createElement('a');
                link.href = currentImage.src;
                link.download = currentImage.src.split('/').pop();
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
            
            // Dr. Fungito análisis
            drFungitoBtn.addEventListener('click', function() {
                // Activar el chat de Dr. Fungito si no está visible
                const drFungitoPanel = document.getElementById('drFungitoPanel');
                if (drFungitoPanel && drFungitoPanel.classList.contains('hidden')) {
                    document.getElementById('drFungitoButton').click();
                }
                
                // Enviar mensaje automático para análisis
                const userInput = document.getElementById('userInput');
                if (userInput) {
                    const analysisPrompt = `Analiza este gráfico de CheckM: ${getCheckmGraphTitle(currentImage.src)}. Proporciona una interpretación detallada de los resultados de control de calidad genómica.`;
                    userInput.value = analysisPrompt;
                    
                    // Simular envío del mensaje
                    const sendButton = document.getElementById('sendButton');
                    if (sendButton) {
                        sendButton.click();
                    }
                }
                
                showNotification('Dr. Fungito', 'Análisis del gráfico CheckM enviado a Dr. Fungito IA', 'info');
            });
            
            // Drag para mover imagen
            currentImage.addEventListener('mousedown', function(e) {
                if (currentScale > 1) {
                    isDragging = true;
                    dragStartX = e.clientX;
                    dragStartY = e.clientY;
                    currentImage.style.cursor = 'grabbing';
                }
            });
            
            document.addEventListener('mousemove', function(e) {
                if (isDragging && currentScale > 1) {
                    const deltaX = e.clientX - dragStartX;
                    const deltaY = e.clientY - dragStartY;
                    currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX + deltaX/currentScale}px, ${initialTransformY + deltaY/currentScale}px)`;
                }
            });
            
            document.addEventListener('mouseup', function() {
                if (isDragging) {
                    isDragging = false;
                    currentImage.style.cursor = 'grab';
                    const transform = currentImage.style.transform;
                    const translateMatch = transform.match(/translate\(([^,]+)px,\s*([^)]+)px\)/);
                    if (translateMatch) {
                        initialTransformX = parseFloat(translateMatch[1]);
                        initialTransformY = parseFloat(translateMatch[2]);
                    }
                }
            });
            
            // Reset posición con doble click
            currentImage.addEventListener('dblclick', function() {
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
        }

        // Obtener título del gráfico CheckM
        function getCheckmGraphTitle(graphUrl) {
            const filename = graphUrl.split('/').pop().replace('.png', '');
            
            const titles = {
                // Análisis de calidad
                'completeness_contamination': '📊 Completitud vs Contaminación',
                'quality_assessment': '✅ Evaluación de Calidad',
                'bins_quality_distribution': '📈 Distribución de Calidad de Bins',
                'lineage_marker_analysis': '🧬 Análisis de Marcadores de Linaje',
                'genome_size_distribution': '📏 Distribución de Tamaños de Genoma',
                
                // Análisis de lineage
                'lineage_tree': '🌳 Árbol de Linaje',
                'marker_gene_analysis': '🎯 Análisis de Genes Marcadores',
                'phylogenetic_placement': '🌿 Ubicación Filogenética',
                'taxonomic_classification': '📋 Clasificación Taxonómica',
                
                // Análisis FNA
                'sequence_length_distribution': '📊 Distribución de Longitudes',
                'gc_content_distribution': '🧬 Distribución de Contenido GC',
                'n50_analysis': '📈 Análisis N50/N90',
                'sequence_statistics': '📊 Estadísticas de Secuencias',
                'codon_usage_analysis': '🔤 Análisis de Uso de Codones',
                'orf_prediction': '🧬 Predicción de ORFs',
                
                // Análisis de bins
                'bin_completeness': '✅ Completitud de Bins',
                'bin_contamination': '❌ Contaminación de Bins',
                'bin_strain_heterogeneity': '🔀 Heterogeneidad de Cepas',
                'marker_lineage_stats': '📊 Estadísticas de Marcadores',
                
                // Gráficos generales
                'quality_summary': '📋 Resumen de Calidad',
                'checkm_overview': '🔬 Resumen CheckM',
                'statistics_overview': '📊 Resumen Estadístico'
            };
            
            for (const [key, title] of Object.entries(titles)) {
                if (filename.includes(key)) {
                    return title;
                }
            }
            
            // Detección por palabras clave específicas
            if (filename.includes('completeness')) return '✅ Análisis de Completitud';
            if (filename.includes('contamination')) return '❌ Análisis de Contaminación';
            if (filename.includes('quality')) return '📊 Análisis de Calidad';
            if (filename.includes('lineage')) return '🧬 Análisis de Linaje';
            if (filename.includes('marker')) return '🎯 Análisis de Marcadores';
            if (filename.includes('tree') || filename.includes('phylo')) return '🌳 Análisis Filogenético';
            if (filename.includes('gc_content') || filename.includes('gc')) return '🧬 Contenido GC';
            if (filename.includes('length') || filename.includes('size')) return '📏 Distribución de Longitudes';
            if (filename.includes('n50') || filename.includes('n90')) return '📈 Análisis N50';
            if (filename.includes('sequence')) return '🧬 Análisis de Secuencias';
            if (filename.includes('bin')) return '📦 Análisis de Bins';
            if (filename.includes('stats') || filename.includes('statistics')) return '📊 Estadísticas';
            if (filename.includes('summary') || filename.includes('overview')) return '📋 Resumen';
            
            return '🔬 Gráfico CheckM';
        }

        // Función para mostrar notificaciones
        function showNotification(title, message, type = 'info') {
            const icon = {
                'success': 'success',
                'error': 'error',
                'warning': 'warning',
                'info': 'info'
            }[type] || 'info';

            Swal.fire({
                icon: icon,
                title: title,
                text: message,
                timer: 3000,
                timerProgressBar: true,
                toast: true,
                position: 'top-end',
                showConfirmButton: false
            });
        }

        // Función para descargar archivo del file manager y procesarlo
        async function downloadAndProcessFile(fileName, filePath, visualizerType) {
            try {
                console.log(`🔍 Iniciando descarga: ${fileName} desde ${filePath}`);
                showNotification('Descargando archivo', `Preparando ${fileName} para análisis...`, 'info');
                
                // Descargar archivo del file manager usando la URL correcta desde el navegador
                const fileManagerUrl = 'http://localhost:4002';
                const downloadUrl = `${fileManagerUrl}/download?path=${encodeURIComponent(filePath)}`;
                
                console.log(`📥 URL de descarga: ${downloadUrl}`);
                
                const response = await fetch(downloadUrl);
                console.log(`📡 Respuesta del file manager: ${response.status} ${response.statusText}`);
                
                if (!response.ok) {
                    throw new Error(`Error al descargar archivo: ${response.status} - ${response.statusText}`);
                }
                
                const blob = await response.blob();
                console.log(`📦 Blob creado: ${blob.size} bytes, tipo: ${blob.type}`);
                
                const file = new File([blob], fileName, { type: blob.type || 'application/octet-stream' });
                console.log(`📄 File object creado: ${file.name}, ${file.size} bytes`);
                
                // Procesar según el tipo de visualizador
                if (visualizerType === 'bindash') {
                    currentSelectedFile = file;
                    currentSelectedFilePath = null;
                    
                    document.getElementById('selectedFileName').textContent = fileName;
                    document.getElementById('selectedFilePath').textContent = 'Archivo del explorador';
                    document.getElementById('selectedFileInfo').style.display = 'block';
                    document.getElementById('processBindashBtn').disabled = false;
                    
                    const selector = document.getElementById('visualizerSelector');
                    if (selector.value !== 'bindash') {
                        selector.value = 'bindash';
                        selector.dispatchEvent(new Event('change'));
                    }
                    
                    console.log(`✅ Archivo BinDash preparado: ${fileName}`);
                    showNotification('Archivo preparado', `${fileName} listo para procesar con BinDash`, 'success');
                } else if (visualizerType === 'eggnog') {
                    currentSelectedFile = file;
                    currentSelectedFilePath = null;
                    
                    const fileType = getEggNOGFileType(fileName);
                    const typeNames = {
                        'seed_orthologs': 'Seed Orthologs',
                        'hits': 'Hits',
                        'annotations': 'Anotaciones'
                    };
                    
                    document.getElementById('selectedEggnogFileName').textContent = fileName;
                    document.getElementById('selectedEggnogFilePath').textContent = 'Archivo del explorador';
                    document.getElementById('selectedEggnogFileType').textContent = `Tipo: ${typeNames[fileType]}`;
                    document.getElementById('selectedEggnogFileInfo').style.display = 'block';
                    document.getElementById('processEggnogBtn').disabled = false;
                    
                    const selector = document.getElementById('visualizerSelector');
                    if (selector.value !== 'eggnog') {
                        selector.value = 'eggnog';
                        selector.dispatchEvent(new Event('change'));
                    }
                    
                    console.log(`✅ Archivo EggNOG preparado: ${fileName}`);
                    showNotification('Archivo preparado', `${fileName} listo para procesar con EggNOG`, 'success');
                } else if (visualizerType === 'checkm') {
                    currentSelectedFile = file;
                    currentSelectedFilePath = null;
                    
                    const fileType = getCheckmFileType(fileName);
                    
                    document.getElementById('selectedCheckmFileName').textContent = fileName;
                    document.getElementById('selectedCheckmFilePath').textContent = 'Archivo del explorador';
                    document.getElementById('selectedCheckmFileType').textContent = `🤖 Tipo detectado: ${fileType}`;
                    document.getElementById('selectedCheckmAnalysisInfo').textContent = getCheckmAnalysisInfo(fileType);
                    document.getElementById('selectedCheckmFileInfo').style.display = 'block';
                    
                    const fnaOptions = document.getElementById('fnaAnalysisOptions');
                    if (fileType === 'Análisis de secuencias FASTA') {
                        fnaOptions.style.display = 'block';
                    } else {
                        fnaOptions.style.display = 'none';
                    }
                    
                    document.getElementById('processCheckmBtn').disabled = false;
                    
                    const selector = document.getElementById('visualizerSelector');
                    if (selector.value !== 'checkm') {
                        selector.value = 'checkm';
                        selector.dispatchEvent(new Event('change'));
                    }
                    
                    console.log(`✅ Archivo CheckM preparado: ${fileName}`);
                    showNotification('Archivo preparado', `${fileName} listo para procesar con CheckM`, 'success');
                }
                
            } catch (error) {
                console.error('❌ Error descargando archivo:', error);
                showNotification('Error', `Error al preparar archivo: ${error.message}`, 'error');
            }
        }

        // Verificar si un archivo es compatible para BinDash
        function isVisualizableFile(fileName) {
            const lowerName = fileName.toLowerCase();
            return lowerName.endsWith('.txt') || 
                   lowerName.endsWith('.tsv') || 
                   lowerName.endsWith('.csv') ||
                   lowerName.endsWith('.tab') ||
                   lowerName.endsWith('.data') ||
                   lowerName.endsWith('.out');
        }

        // Manejar drag over para BinDash
        function handleBindashDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        // Manejar drag leave para BinDash
        function handleBindashDragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        // Funciones de drop para BinDash
        function handleBindashDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            
            console.log('🎯 handleBindashDrop ejecutado');
            
            // Intentar obtener datos del file explorer
            try {
                const dragData = e.dataTransfer.getData('text/plain');
                console.log('📋 Datos de drag:', dragData);
                
                if (dragData) {
                    const fileData = JSON.parse(dragData);
                    console.log('📄 Datos del archivo:', fileData);
                    
                    if (fileData.fileName && fileData.filePath && !fileData.isDirectory) {
                        if (isVisualizableFile(fileData.fileName)) {
                            console.log('✅ Archivo compatible, descargando...');
                            // Descargar archivo del file manager y luego procesarlo
                            downloadAndProcessFile(fileData.fileName, fileData.filePath, 'bindash');
                        } else {
                            console.log(`❌ Archivo no compatible con BinDash: ${fileData.fileName}`);
                            showNotification('Archivo no compatible', 
                                `El archivo "${fileData.fileName}" no es compatible con BinDash. Usa archivos .txt, .tsv, .csv`, 
                                'warning');
                        }
                        return;
                    } else if (fileData.isDirectory) {
                        console.log('📁 Carpeta arrastrada a BinDash, ignorando');
                        return;
                    }
                }
            } catch (error) {
                console.log('⚠️ No hay datos del file explorer, intentando con archivos locales');
            }
            
            // Si no hay datos del file explorer, usar archivos locales
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (isVisualizableFile(file.name)) {
                    console.log('📁 Usando archivo local:', file.name);
                    handleBindashFileSelect({ target: { files: files } });
                } else {
                    console.log(`❌ Archivo local no compatible: ${file.name}`);
                    showNotification('Archivo no compatible', 
                        `El archivo "${file.name}" no es compatible con BinDash. Usa archivos .txt, .tsv, .csv`, 
                        'warning');
                }
            }
        }

        // Manejar selección de archivo BinDash
        function handleBindashFileSelect(e) {
            const file = e.target.files[0];
            if (file) {
                console.log('📁 Archivo seleccionado:', file.name, file.size, 'bytes');
                currentSelectedFile = file;
                currentSelectedFilePath = null;
                
                document.getElementById('selectedFileName').textContent = file.name;
                document.getElementById('selectedFilePath').textContent = 'Archivo local';
                document.getElementById('selectedFileInfo').style.display = 'block';
                document.getElementById('processBindashBtn').disabled = false;

                showNotification('Archivo cargado', `Se ha cargado el archivo: ${file.name}`, 'success');
            }
        }

    </script>
</body>
