        // Configurar controles de gráficos EggNOG
        function setupEggnogGraphControls(graphs) {
            const selector = document.getElementById('eggnogGraphSelector');
            const currentImage = document.getElementById('currentEggnogGraphImage');
            const graphTitle = document.getElementById('eggnogGraphTitle');
            const drFungitoBtn = document.getElementById('eggnogDrFungitoAnalyzeBtn');
            const zoomInBtn = document.getElementById('eggnogZoomInBtn');
            const zoomOutBtn = document.getElementById('eggnogZoomOutBtn');
            const fullscreenBtn = document.getElementById('eggnogFullscreenBtn');
            const downloadBtn = document.getElementById('eggnogDownloadBtn');
            
            let currentScale = 1;
            let isDragging = false;
            let dragStartX, dragStartY, initialTransformX = 0, initialTransformY = 0;
            
            // Cambiar gráfico
            selector.addEventListener('change', function() {
                const selectedIndex = parseInt(this.value);
                const selectedGraph = graphs[selectedIndex];
                currentImage.src = selectedGraph;
                graphTitle.textContent = getEggnogGraphTitle(selectedGraph);
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
            
            // Zoom in
            zoomInBtn.addEventListener('click', function() {
                currentScale = Math.min(currentScale * 1.2, 3);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Zoom out  
            zoomOutBtn.addEventListener('click', function() {
                currentScale = Math.max(currentScale / 1.2, 0.5);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Pantalla completa
            fullscreenBtn.addEventListener('click', function() {
                if (currentImage.requestFullscreen) {
                    currentImage.requestFullscreen();
                } else if (currentImage.webkitRequestFullscreen) {
                    currentImage.webkitRequestFullscreen();
                } else if (currentImage.mozRequestFullScreen) {
                    currentImage.mozRequestFullScreen();
                }
            });
            
            // Descargar
            downloadBtn.addEventListener('click', function() {
                const link = document.createElement('a');
                link.href = currentImage.src;
                link.download = currentImage.src.split('/').pop();
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
            
            // Dr. Fungito análisis
            drFungitoBtn.addEventListener('click', function() {
                // Activar el chat de Dr. Fungito si no está visible
                const drFungitoPanel = document.getElementById('drFungitoPanel');
                if (drFungitoPanel && drFungitoPanel.classList.contains('hidden')) {
                    document.getElementById('drFungitoButton').click();
                }
                
                // Enviar mensaje automático para análisis
                const userInput = document.getElementById('userInput');
                if (userInput) {
                    const analysisPrompt = `Analiza este gráfico de EggNOG: ${getEggnogGraphTitle(currentImage.src)}. Proporciona una interpretación detallada de los resultados de análisis funcional.`;
                    userInput.value = analysisPrompt;
                    
                    // Simular envío del mensaje
                    const sendButton = document.getElementById('sendButton');
                    if (sendButton) {
                        sendButton.click();
                    }
                }
                
                showNotification('Dr. Fungito', 'Análisis del gráfico EggNOG enviado a Dr. Fungito IA', 'info');
            });
            
            // Drag para mover imagen
            currentImage.addEventListener('mousedown', function(e) {
                if (currentScale > 1) {
                    isDragging = true;
                    dragStartX = e.clientX;
                    dragStartY = e.clientY;
                    currentImage.style.cursor = 'grabbing';
                }
            });
            
            document.addEventListener('mousemove', function(e) {
                if (isDragging && currentScale > 1) {
                    const deltaX = e.clientX - dragStartX;
                    const deltaY = e.clientY - dragStartY;
                    currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX + deltaX/currentScale}px, ${initialTransformY + deltaY/currentScale}px)`;
                }
            });
            
            document.addEventListener('mouseup', function() {
                if (isDragging) {
                    isDragging = false;
                    currentImage.style.cursor = 'grab';
                    const transform = currentImage.style.transform;
                    const translateMatch = transform.match(/translate\(([^,]+)px,\s*([^)]+)px\)/);
                    if (translateMatch) {
                        initialTransformX = parseFloat(translateMatch[1]);
                        initialTransformY = parseFloat(translateMatch[2]);
                    }
                }
            });
            
            // Reset posición con doble click
            currentImage.addEventListener('dblclick', function() {
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
        }

        // Obtener título del gráfico EggNOG
        function getEggnogGraphTitle(graphUrl) {
            const filename = graphUrl.split('/').pop().replace('.png', '');
            
            const titles = {
                // Análisis de Anotaciones
                'annotation_coverage': '🔬 Cobertura de Anotaciones',
                'annotation_stats': '📊 Estadísticas de Anotaciones',
                'go_analysis': '🧬 Análisis Gene Ontology (GO)',
                'kegg_pathways': '🗺️ Vías KEGG',
                'cog_categories': '⚙️ Categorías COG',
                'pfam_domains': '🧩 Dominios Pfam',
                'description_wordcloud': '☁️ Nube de Descripciones',
                'evalue_distribution': '📈 Distribución E-values',
                'score_distribution': '📊 Distribución de Scores',
                
                // Análisis de Hits
                'hits_analysis': '🎯 Análisis de Hits',
                'hits_distribution': '📈 Distribución de Hits',
                'hits_quality': '✅ Calidad de Hits',
                'identity_coverage': '🔍 Identidad vs Cobertura',
                'hits_heatmap': '🔥 Mapa de Calor - Hits',
                
                // Análisis de Seed Orthologs
                'seed_ortholog_analysis': '🌱 Análisis Seed Orthologs',
                'ortholog_quality': '⭐ Calidad de Ortólogos',
                'coverage_identity': '📊 Cobertura vs Identidad',
                'taxonomic_distribution': '🌿 Distribución Taxonómica',
                'top_orthologs': '🏆 Top Ortólogos',
                
                // Gráficos generales
                'statistics': '📊 Estadísticas Generales',
                'summary': '📋 Resumen del Análisis',
                'quality_control': '🔬 Control de Calidad'
            };
            
            for (const [key, title] of Object.entries(titles)) {
                if (filename.includes(key)) {
                    return title;
                }
            }
            
            // Detección por palabras clave específicas
            if (filename.includes('seed_ortholog') || filename.includes('orthologs')) return '🌱 Análisis Seed Orthologs';
            if (filename.includes('hits')) return '🎯 Análisis de Hits';
            if (filename.includes('annotation')) return '🔬 Análisis de Anotaciones';
            if (filename.includes('go_') || filename.includes('gene_ontology')) return '🧬 Análisis GO';
            if (filename.includes('kegg_') || filename.includes('pathway')) return '🗺️ Análisis KEGG';
            if (filename.includes('cog_') || filename.includes('cluster_ortholog')) return '⚙️ Análisis COG';
            if (filename.includes('pfam_') || filename.includes('domain')) return '🧩 Análisis Pfam';
            if (filename.includes('score') || filename.includes('evalue')) return '📊 Distribución de Scores';
            if (filename.includes('coverage')) return '📈 Análisis de Cobertura';
            if (filename.includes('identity')) return '🔍 Análisis de Identidad';
            if (filename.includes('stats') || filename.includes('statistics')) return '📊 Estadísticas';
            if (filename.includes('quality')) return '✅ Control de Calidad';
            if (filename.includes('heatmap')) return '🔥 Mapa de Calor';
            if (filename.includes('distribution')) return '📈 Distribución';
            if (filename.includes('wordcloud')) return '☁️ Nube de Palabras';
            
            return '🧬 Gráfico EggNOG';
        }

        // ===== FUNCIONES PARA VISUALIZADOR CHECKM =====

        // Configurar drag and drop para CheckM
        function setupCheckmDragDrop() {
            const dropZone = document.getElementById('checkmDropZone');
            const fileInput = document.getElementById('checkmFileInput');
            const processBtn = document.getElementById('processCheckmBtn');

            if (!dropZone || !fileInput || !processBtn) return;

            // Eventos del drop zone
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', handleCheckmDragOver);
            dropZone.addEventListener('drop', handleCheckmDrop);
            dropZone.addEventListener('dragleave', handleCheckmDragLeave);

            // Evento del input de archivo
            fileInput.addEventListener('change', handleCheckmFileSelect);

            // Evento del botón de procesar
            processBtn.addEventListener('click', processCheckmFile);
        }

        // Verificar si un archivo es compatible para CheckM
        function isCheckmFile(fileName) {
            const lowerName = fileName.toLowerCase();
            return lowerName.endsWith('.tsv') || 
                   lowerName.endsWith('.txt') ||
                   lowerName.endsWith('.fna') ||
                   lowerName.endsWith('.fasta') ||
                   lowerName.endsWith('.fa') ||
                   lowerName.endsWith('.tree') ||
                   lowerName.endsWith('.nwk') ||
                   lowerName.endsWith('.csv') ||
                   lowerName.endsWith('.analyze') ||
                   lowerName.includes('lineage') ||
                   lowerName.includes('bins') ||
                   lowerName.includes('checkm') ||
                   lowerName.includes('qa_results') ||
                   lowerName.includes('tree_qa') ||
                   lowerName.includes('hmmer');
        }
        
        // Detectar tipo específico de archivo CheckM (detección automática)
        function getCheckmFileType(fileName) {
            const lowerName = fileName.toLowerCase();
            
            if (lowerName.endsWith('.fna') || lowerName.endsWith('.fasta') || lowerName.endsWith('.fa')) {
                return 'Análisis de secuencias FASTA';
            } else if (lowerName.endsWith('.tree') || lowerName.endsWith('.nwk')) {
                return 'Análisis filogenético';
            } else if (lowerName.includes('hmmer.analyze') || lowerName.endsWith('.analyze')) {
                return 'Análisis HMMER';
            } else if (lowerName.includes('hmmer.tree')) {
                return 'Árbol HMMER';
            } else if (lowerName.includes('lineage') || lowerName.includes('ms.tsv')) {
                return 'Análisis de linaje CheckM';
            } else if (lowerName.includes('bins') || lowerName.includes('stats')) {
                return 'Estadísticas de bins CheckM';
            } else if (lowerName.includes('qa_results') || lowerName.includes('qa.tsv')) {
                return 'Resultados de calidad CheckM';
            } else if (lowerName.includes('checkm')) {
                return 'Análisis CheckM general';
            }
            
            return 'Análisis CheckM general'; // Por defecto
        }



        // Manejar drag over para CheckM
        function handleCheckmDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        // Manejar drag leave para CheckM
        function handleCheckmDragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        // Manejar drop para CheckM
        function handleCheckmDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            
            // Intentar obtener datos del file explorer
            try {
                const dragData = e.dataTransfer.getData('text/plain');
                if (dragData) {
                    const fileData = JSON.parse(dragData);
                    if (fileData.fileName && fileData.filePath && !fileData.isDirectory) {
                        if (isCheckmFile(fileData.fileName)) {
                            // Descargar archivo del file manager y luego procesarlo
                            downloadAndProcessFile(fileData.fileName, fileData.filePath, 'checkm');
                        } else {
                            console.log(`Archivo no compatible con CheckM: ${fileData.fileName}`);
                        }
                        return;
                    } else if (fileData.isDirectory) {
                        console.log('Carpeta arrastrada a CheckM, ignorando');
                        return;
                    }
                }
            } catch (error) {
                console.log('No hay datos del file explorer, intentando con archivos locales');
            }
            
            // Si no hay datos del file explorer, usar archivos locales
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (isCheckmFile(file.name)) {
                    handleCheckmFileSelect({ target: { files: files } });
                } else {
                    console.log(`Archivo no compatible con CheckM: ${file.name}`);
                }
            }
        }

