            document.getElementById('totalEggnogRecords').textContent = stats.total_records || stats.total_annotations || stats.total_hits || stats.total_seed_orthologs || 'N/A';
            document.getElementById('uniqueEggnogQueries').textContent = stats.unique_queries || stats.unique_proteins || 'N/A';
            document.getElementById('eggnogFileTypeDisplay').textContent = fileType.replace('_', ' ').toUpperCase();
            document.getElementById('eggnogCoverage').textContent = stats.coverage ? `${stats.coverage}%` : 'N/A';
            
            statsPanel.style.display = 'block';
        }

