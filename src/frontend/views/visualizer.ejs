                    const deltaX = e.clientX - dragStartX;
                    const deltaY = e.clientY - dragStartY;
                    currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX + deltaX/currentScale}px, ${initialTransformY + deltaY/currentScale}px)`;
                }
            });
            
            document.addEventListener('mouseup', function() {
                if (isDragging) {
                    isDragging = false;
                    currentImage.style.cursor = 'grab';
                    const transform = currentImage.style.transform;
                    const translateMatch = transform.match(/translate\(([^,]+)px,\s*([^)]+)px\)/);
                    if (translateMatch) {
                        initialTransformX = parseFloat(translateMatch[1]);
                        initialTransformY = parseFloat(translateMatch[2]);
                    }
                }
            });
            
            // Reset posición con doble click
            currentImage.addEventListener('dblclick', function() {
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
        }

        // Obtener título del gráfico EggNOG
        function getEggnogGraphTitle(graphUrl) {
            const filename = graphUrl.split('/').pop().replace('.png', '');
            
            const titles = {
                // Análisis de Anotaciones
                'annotation_coverage': '🔬 Cobertura de Anotaciones',
                'annotation_stats': '📊 Estadísticas de Anotaciones',
                'go_analysis': '🧬 Análisis Gene Ontology (GO)',
                'kegg_pathways': '🗺️ Vías KEGG',
                'cog_categories': '⚙️ Categorías COG',
                'pfam_domains': '🧩 Dominios Pfam',
                'description_wordcloud': '☁️ Nube de Descripciones',
                'evalue_distribution': '📈 Distribución E-values',
                'score_distribution': '📊 Distribución de Scores',
                
                // Análisis de Hits
                'hits_analysis': '🎯 Análisis de Hits',
                'hits_distribution': '📈 Distribución de Hits',
                'hits_quality': '✅ Calidad de Hits',
                'identity_coverage': '🔍 Identidad vs Cobertura',
                'hits_heatmap': '🔥 Mapa de Calor - Hits',
                
                // Análisis de Seed Orthologs
                'seed_ortholog_analysis': '🌱 Análisis Seed Orthologs',
                'ortholog_quality': '⭐ Calidad de Ortólogos',
                'coverage_identity': '📊 Cobertura vs Identidad',
                'taxonomic_distribution': '🌿 Distribución Taxonómica',
                'top_orthologs': '🏆 Top Ortólogos',
                
                // Gráficos generales
                'statistics': '📊 Estadísticas Generales',
                'summary': '📋 Resumen del Análisis',
                'quality_control': '🔬 Control de Calidad'
            };
            
            for (const [key, title] of Object.entries(titles)) {
                if (filename.includes(key)) {
                    return title;
                }
            }
            
            // Detección por palabras clave específicas
            if (filename.includes('seed_ortholog') || filename.includes('orthologs')) return '🌱 Análisis Seed Orthologs';
            if (filename.includes('hits')) return '🎯 Análisis de Hits';
            if (filename.includes('annotation')) return '🔬 Análisis de Anotaciones';
            if (filename.includes('go_') || filename.includes('gene_ontology')) return '🧬 Análisis GO';
            if (filename.includes('kegg_') || filename.includes('pathway')) return '🗺️ Análisis KEGG';
            if (filename.includes('cog_') || filename.includes('cluster_ortholog')) return '⚙️ Análisis COG';
            if (filename.includes('pfam_') || filename.includes('domain')) return '🧩 Análisis Pfam';
            if (filename.includes('score') || filename.includes('evalue')) return '📊 Distribución de Scores';
            if (filename.includes('coverage')) return '📈 Análisis de Cobertura';
            if (filename.includes('identity')) return '🔍 Análisis de Identidad';
            if (filename.includes('stats') || filename.includes('statistics')) return '📊 Estadísticas';
            if (filename.includes('quality')) return '✅ Control de Calidad';
            if (filename.includes('heatmap')) return '🔥 Mapa de Calor';
            if (filename.includes('distribution')) return '📈 Distribución';
            if (filename.includes('wordcloud')) return '☁️ Nube de Palabras';
            
            return '🧬 Gráfico EggNOG';
        }

        // Función para mostrar notificaciones
        function showNotification(title, message, type = 'info') {
            const icon = {
                'success': 'success',
                'error': 'error',
                'warning': 'warning',
                'info': 'info'
            }[type] || 'info';

            Swal.fire({
                icon: icon,
                title: title,
                text: message,
                timer: 3000,
                timerProgressBar: true,
                toast: true,
                position: 'top-end',
                showConfirmButton: false
            });
        }
    </script>
