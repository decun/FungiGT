    <script>
        // Variables globales
        let currentSelectedFile = null;
        let currentSelectedFilePath = null;
        const bindashVisualizerUrl = 'http://localhost:4003';

        // Inicialización
        document.addEventListener('DOMContentLoaded', function() {
            setupVisualizerSelector();
            setupBindashDragDrop();
            setupEggnogDragDrop();
            setupCheckmDragDrop();
            setupFileExplorerIntegration();
        });

        // Configurar selector de visualizadores
        function setupVisualizerSelector() {
            const selector = document.getElementById('visualizerSelector');
            
            selector.addEventListener('change', function() {
                // Ocultar todas las secciones
                document.querySelectorAll('[id$="VisualizerSection"]').forEach(section => {
                    section.style.display = 'none';
                });
                
                // Mostrar la sección seleccionada
                const selectedValue = this.value;
                if (selectedValue) {
                    const sectionId = selectedValue + 'VisualizerSection';
                    const section = document.getElementById(sectionId);
                    if (section) {
                        section.style.display = 'block';
                    }
                }
            });
        }

        // Configurar drag and drop para BinDash
        function setupBindashDragDrop() {
            const dropZone = document.getElementById('bindashDropZone');
            const fileInput = document.getElementById('bindashFileInput');
            const processBtn = document.getElementById('processBindashBtn');

            // Eventos del drop zone
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', handleBindashDragOver);
            dropZone.addEventListener('drop', handleBindashDrop);
            dropZone.addEventListener('dragleave', handleBindashDragLeave);

            // Evento del input de archivo
            fileInput.addEventListener('change', handleBindashFileSelect);

            // Evento del botón de procesar
            processBtn.addEventListener('click', processBindashFile);
        }

        // Configurar integración con file explorer
        function setupFileExplorerIntegration() {
            // Escuchar clicks en elementos del file explorer
            document.addEventListener('click', function(e) {
                const fileElement = e.target.closest('[data-file-path]');
                if (fileElement) {
                    const fileName = fileElement.dataset.fileName || fileElement.textContent.trim();
                    const filePath = fileElement.dataset.filePath;
                    
                    if (fileName && filePath) {
                        // Verificar si es un archivo compatible con BinDash
                        if (fileName.match(/\.(txt|tsv|csv)$/i)) {
                            selectFileFromExplorer(fileName, filePath);
                        } else {
                            showNotification('Archivo no compatible', 'El archivo seleccionado no es compatible con BinDash. Selecciona un archivo .txt, .tsv o .csv', 'warning');
                        }
                    }
                }
            });

            // Configurar drag desde file explorer
            document.addEventListener('dragstart', function(e) {
                const fileElement = e.target.closest('[data-file-path]');
                if (fileElement) {
                    const fileName = fileElement.dataset.fileName || fileElement.textContent.trim();
                    const filePath = fileElement.dataset.filePath;
                    
                    e.dataTransfer.setData('text/plain', JSON.stringify({
                        fileName: fileName,
                        filePath: filePath
                    }));
                }
            });
        }

        // Seleccionar archivo desde el explorador
        function selectFileFromExplorer(fileName, filePath) {
            currentSelectedFile = { name: fileName };
            currentSelectedFilePath = filePath;
            
            // Mostrar información del archivo
            document.getElementById('selectedFileName').textContent = fileName;
            document.getElementById('selectedFilePath').textContent = filePath;
            document.getElementById('selectedFileInfo').style.display = 'block';
            
            // Habilitar botón de procesar
            document.getElementById('processBindashBtn').disabled = false;
            
            // Cambiar al visualizador BinDash si no está seleccionado
            const selector = document.getElementById('visualizerSelector');
            if (selector.value !== 'bindash') {
                selector.value = 'bindash';
                selector.dispatchEvent(new Event('change'));
            }

            showNotification('Archivo seleccionado', `Se ha seleccionado el archivo: ${fileName}`, 'success');
        }

        // Manejar drag over
        function handleDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        // Manejar drag leave
        function handleDragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        // Manejar drop
        function handleDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            
            // Intentar obtener datos del file explorer
            try {
                const dragData = e.dataTransfer.getData('text/plain');
                if (dragData) {
                    const fileData = JSON.parse(dragData);
                    if (fileData.fileName && fileData.filePath && !fileData.isDirectory) {
                        selectFileFromExplorer(fileData.fileName, fileData.filePath);
                        return;
                    } else if (fileData.isDirectory) {
                        // No hacer nada si es una carpeta, solo log
                        console.log('Carpeta arrastrada a BinDash, ignorando');
                        return;
                    }
                }
            } catch (error) {
                console.log('No hay datos del file explorer, intentando con archivos locales');
            }
            
            // Si no hay datos del file explorer, usar archivos locales
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleFileSelect({ target: { files: files } });
            }
        }

        // Manejar selección de archivo
        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (file) {
                currentSelectedFile = file;
                currentSelectedFilePath = null; // Es un archivo local, no del servidor
                
                // Mostrar información del archivo
                document.getElementById('selectedFileName').textContent = file.name;
                document.getElementById('selectedFilePath').textContent = 'Archivo local';
                document.getElementById('selectedFileInfo').style.display = 'block';
                
                // Habilitar botón de procesar
                document.getElementById('processBindashBtn').disabled = false;

                showNotification('Archivo cargado', `Se ha cargado el archivo: ${file.name}`, 'success');
            }
        }

        // Procesar archivo con BinDash
        function processBindashFile() {
            console.log('🚀 Iniciando procesamiento BinDash...');
            console.log('📁 currentSelectedFile:', currentSelectedFile);
            console.log('📂 currentSelectedFilePath:', currentSelectedFilePath);
            
            const statusElement = document.getElementById('bindashStatus');
            const graphsContainer = document.getElementById('bindashGraphsContainer');
            const statsPanel = document.getElementById('bindashStatsPanel');
            
            // Limpiar contenido anterior
            graphsContainer.innerHTML = '';
            statsPanel.style.display = 'none';
            
            // Mostrar estado de carga
            statusElement.innerHTML = '<div class="loading-spinner"></div> Procesando archivo...';
            statusElement.className = 'mb-6 text-sm text-blue-600';
            
            const formData = new FormData();
            
            if (currentSelectedFilePath) {
                // Archivo del servidor
                console.log('📂 Usando archivo del servidor:', currentSelectedFilePath);
                formData.append('filePath', currentSelectedFilePath);
            } else if (currentSelectedFile) {
                // Archivo local
                console.log('📁 Usando archivo local:', currentSelectedFile.name, currentSelectedFile.size, 'bytes');
                formData.append('file', currentSelectedFile);
            } else {
                console.error('❌ No hay archivo seleccionado');
                statusElement.textContent = '❌ Error: No hay archivo seleccionado';
                statusElement.className = 'mb-6 text-sm text-red-600';
                return;
            }
            
            console.log('🌐 Enviando petición a:', `${bindashVisualizerUrl}/process-bindash`);
            
            fetch(`${bindashVisualizerUrl}/process-bindash`, {
                method: 'POST',
                body: formData
            })
            .then(response => {
                console.log('📡 Respuesta del servidor:', response.status, response.statusText);
                if (!response.ok) {
                    return response.text().then(text => {
                        console.error('❌ Error del servidor:', text);
                        throw new Error(`Error HTTP: ${response.status} - ${text}`);
                    });
                }
                return response.json();
            })
            .then(data => {
                console.log('✅ Resultado BinDash:', data);
                statusElement.textContent = `✅ Archivo procesado exitosamente (${data.graphs?.length || 0} gráficos generados)`;
                statusElement.className = 'mb-6 text-sm text-green-600';
                
                // Mostrar estadísticas
                if (data.stats) {
                    displayBinDashStats(data.stats);
                }
                
                // Mostrar gráficos
                if (data.graphs && data.graphs.length > 0) {
                    displayBinDashGraphs(data.graphs);
                }

                showNotification('Procesamiento completado', 'El archivo ha sido procesado exitosamente', 'success');
            })
            .catch(error => {
                console.error('❌ Error procesando archivo BinDash:', error);
                statusElement.textContent = `❌ Error: ${error.message}`;
                statusElement.className = 'mb-6 text-sm text-red-600';
                showNotification('Error de procesamiento', error.message, 'error');
            });
        }

        // Mostrar estadísticas de BinDash
        function displayBinDashStats(stats) {
            const statsPanel = document.getElementById('bindashStatsPanel');
            
            document.getElementById('totalComparisons').textContent = stats.total_comparisons || 'N/A';
            document.getElementById('uniqueGenomes').textContent = stats.unique_genomes || 'N/A';
            document.getElementById('meanANI').textContent = stats.avg_jaccard ? stats.avg_jaccard.toFixed(3) : 'N/A';
            document.getElementById('meanDistance').textContent = stats.avg_mutation_distance ? stats.avg_mutation_distance.toFixed(3) : 'N/A';
            
            statsPanel.style.display = 'block';
        }

        // Mostrar gráficos de BinDash
        function displayBinDashGraphs(graphs) {
            const container = document.getElementById('bindashGraphsContainer');
            
            // Corregir URLs para que apunten al puerto correcto
            const correctedGraphs = graphs.map(graphUrl => {
                if (graphUrl.startsWith('/graphs/')) {
                    return `${bindashVisualizerUrl}${graphUrl}`;
                }
                return graphUrl.replace('http://localhost:4005', bindashVisualizerUrl);
            });
            
            const selectorHTML = `
                <div class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <label class="font-medium text-gray-700">Seleccionar Gráfico:</label>
                        <select id="graphSelector" class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500">
                            ${correctedGraphs.map((graphUrl, index) => {
                                const title = getGraphTitle(graphUrl);
                                return `<option value="${index}" ${index === 0 ? 'selected' : ''}>${title}</option>`;
                            }).join('')}
                        </select>
                    </div>
                    
                    <div class="relative bg-gray-50 rounded-lg border-2 border-gray-200">
                        <div class="absolute top-3 right-3 z-10 flex space-x-2">
                            <button id="drFungitoAnalyzeBtn" class="bg-green-500 bg-opacity-80 hover:bg-opacity-100 text-white p-2 rounded hover:scale-110 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-green-400" title="Analizar con Dr. Fungito IA">
                                <i class="fas fa-search text-sm"></i>
                            </button>
                            <button id="zoomInBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all">
                                <i class="fas fa-search-plus text-sm"></i>
                            </button>
                            <button id="zoomOutBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all">
                                <i class="fas fa-search-minus text-sm"></i>
                            </button>
                            <button id="fullscreenBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all">
                                <i class="fas fa-expand text-sm"></i>
                            </button>
                            <button id="downloadBtn" class="bg-gray-800 bg-opacity-75 text-white p-2 rounded hover:bg-opacity-100 transition-all">
                                <i class="fas fa-download text-sm"></i>
                            </button>
                        </div>
                        
                        <div class="absolute top-3 left-3 z-10">
                            <h5 id="graphTitle" class="bg-white bg-opacity-90 px-3 py-1 rounded-md text-sm font-semibold text-gray-800 shadow-sm">
                                ${getGraphTitle(correctedGraphs[0])}
                            </h5>
                        </div>
                        
                        <div class="p-6 min-h-[500px] flex items-center justify-center">
                            <img id="currentGraphImage" 
                                 src="${correctedGraphs[0]}" 
                                 alt="Gráfico BinDash" 
                                 class="max-w-full max-h-[500px] object-contain rounded-lg shadow-lg transition-transform duration-200"
                                 style="cursor: grab;"
                                 onerror="this.src='data:image/svg+xml;base64,'; this.alt='Error cargando imagen';" />
                        </div>
                    </div>
                </div>
            `;
            
            container.innerHTML = selectorHTML;
            setupGraphControls(correctedGraphs);
        }

        // Configurar controles de gráficos
        function setupGraphControls(graphs) {
            const selector = document.getElementById('graphSelector');
            const currentImage = document.getElementById('currentGraphImage');
            const graphTitle = document.getElementById('graphTitle');
            const drFungitoBtn = document.getElementById('drFungitoAnalyzeBtn');
            const zoomInBtn = document.getElementById('zoomInBtn');
            const zoomOutBtn = document.getElementById('zoomOutBtn');
            const fullscreenBtn = document.getElementById('fullscreenBtn');
            const downloadBtn = document.getElementById('downloadBtn');
            
            let currentScale = 1;
            let isDragging = false;
            let dragStartX, dragStartY, initialTransformX = 0, initialTransformY = 0;
            
            // Cambiar gráfico
            selector.addEventListener('change', function() {
                const selectedIndex = parseInt(this.value);
                const selectedGraph = graphs[selectedIndex];
                currentImage.src = selectedGraph;
                graphTitle.textContent = getGraphTitle(selectedGraph);
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
            
            // Zoom in
            zoomInBtn.addEventListener('click', function() {
                currentScale = Math.min(currentScale * 1.2, 3);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Zoom out  
            zoomOutBtn.addEventListener('click', function() {
                currentScale = Math.max(currentScale / 1.2, 0.5);
                currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX}px, ${initialTransformY}px)`;
            });
            
            // Pantalla completa
            fullscreenBtn.addEventListener('click', function() {
                if (currentImage.requestFullscreen) {
                    currentImage.requestFullscreen();
                } else if (currentImage.webkitRequestFullscreen) {
                    currentImage.webkitRequestFullscreen();
                } else if (currentImage.mozRequestFullScreen) {
                    currentImage.mozRequestFullScreen();
                }
            });
            
            // Descargar
            downloadBtn.addEventListener('click', function() {
                const link = document.createElement('a');
                link.href = currentImage.src;
                link.download = currentImage.src.split('/').pop();
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
            
            // Dr. Fungito análisis
            drFungitoBtn.addEventListener('click', function() {
                showNotification('Dr. Fungito', 'Función de análisis con Dr. Fungito en desarrollo', 'info');
            });
            
            // Drag para mover imagen
            currentImage.addEventListener('mousedown', function(e) {
                if (currentScale > 1) {
                    isDragging = true;
                    dragStartX = e.clientX;
                    dragStartY = e.clientY;
                    currentImage.style.cursor = 'grabbing';
                }
            });
            
            document.addEventListener('mousemove', function(e) {
                if (isDragging && currentScale > 1) {
                    const deltaX = e.clientX - dragStartX;
                    const deltaY = e.clientY - dragStartY;
                    currentImage.style.transform = `scale(${currentScale}) translate(${initialTransformX + deltaX/currentScale}px, ${initialTransformY + deltaY/currentScale}px)`;
                }
            });
            
            document.addEventListener('mouseup', function() {
                if (isDragging) {
                    isDragging = false;
                    currentImage.style.cursor = 'grab';
                    const transform = currentImage.style.transform;
                    const translateMatch = transform.match(/translate\(([^,]+)px,\s*([^)]+)px\)/);
                    if (translateMatch) {
                        initialTransformX = parseFloat(translateMatch[1]);
                        initialTransformY = parseFloat(translateMatch[2]);
                    }
                }
            });
            
            // Reset posición con doble click
            currentImage.addEventListener('dblclick', function() {
                currentScale = 1;
                initialTransformX = 0;
                initialTransformY = 0;
                currentImage.style.transform = 'scale(1) translate(0px, 0px)';
            });
        }

        // Obtener título del gráfico
        function getGraphTitle(graphUrl) {
            const filename = graphUrl.split('/').pop().replace('.png', '');
            const titles = {
                'distance_heatmap': '🔥 Mapa de Calor - Distancias',
                'ani_heatmap': '🔥 Mapa de Calor - ANI', 
                'correlation_heatmap': '🔥 Mapa de Calor - Correlaciones',
                'dendrogram_simple': '🌳 Dendrograma Simple',
                'distance_distributions': '📊 Distribución de Distancias',
                'scatter_analysis': '📈 Análisis de Dispersión',
                'mds_analysis': '🗺️ Análisis Multidimensional'
            };
            
            for (const [key, title] of Object.entries(titles)) {
                if (filename.includes(key)) {
                    return title;
                }
            }
            
            return '📊 Gráfico de Análisis';
        }

        // ===== FUNCIONES PARA VISUALIZADOR EGGNOG =====

        // Configurar drag and drop para EggNOG
        function setupEggnogDragDrop() {
            const dropZone = document.getElementById('eggnogDropZone');
            const fileInput = document.getElementById('eggnogFileInput');
            const processBtn = document.getElementById('processEggnogBtn');

            if (!dropZone || !fileInput || !processBtn) return;

            // Eventos del drop zone
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', handleEggnogDragOver);
            dropZone.addEventListener('drop', handleEggnogDrop);
            dropZone.addEventListener('dragleave', handleEggnogDragLeave);

            // Evento del input de archivo
            fileInput.addEventListener('change', handleEggnogFileSelect);

            // Evento del botón de procesar
            processBtn.addEventListener('click', processEggnogFile);
        }

        // Verificar si un archivo es compatible para EggNOG
        function isEggNOGFile(fileName) {
            const lowerName = fileName.toLowerCase();
            return lowerName.includes('.emapper.annotations') || 
                   lowerName.includes('.emapper.seed_orthologs') ||
                   lowerName.includes('.emapper.hits') ||
                   lowerName.endsWith('.annotations') ||
                   lowerName.endsWith('.seed_orthologs') ||
                   lowerName.endsWith('.hits') ||
                   lowerName.includes('eggnog') ||
                   (lowerName.endsWith('.tsv') && (lowerName.includes('annot') || lowerName.includes('seed') || lowerName.includes('hits'))) ||
                   (lowerName.endsWith('.txt') && (lowerName.includes('annot') || lowerName.includes('seed') || lowerName.includes('hits')));
        }
        
        // Detectar tipo específico de archivo EggNOG
        function getEggNOGFileType(fileName) {
            const lowerName = fileName.toLowerCase();
            if (lowerName.includes('seed_orthologs') || lowerName.includes('seed-orthologs')) {
                return 'seed_orthologs';
            } else if (lowerName.includes('hits')) {
                return 'hits';
            } else if (lowerName.includes('annotations') || lowerName.includes('annot')) {
                return 'annotations';
            }
            return 'annotations'; // Por defecto
        }

        // Manejar drag over para EggNOG
        function handleEggnogDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        // Manejar drag leave para EggNOG
        function handleEggnogDragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        // Manejar drop para EggNOG
        function handleEggnogDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            
            // Intentar obtener datos del file explorer
            try {
                const dragData = e.dataTransfer.getData('text/plain');
                if (dragData) {
                    const fileData = JSON.parse(dragData);
                    if (fileData.fileName && fileData.filePath && !fileData.isDirectory) {
                        if (isEggNOGFile(fileData.fileName)) {
                            // Descargar archivo del file manager y luego procesarlo
                            downloadAndProcessFile(fileData.fileName, fileData.filePath, 'eggnog');
                        } else {
                            console.log(`Archivo no compatible con EggNOG: ${fileData.fileName}`);
                        }
                        return;
                    } else if (fileData.isDirectory) {
                        console.log('Carpeta arrastrada a EggNOG, ignorando');
                        return;
                    }
                }
            } catch (error) {
                console.log('No hay datos del file explorer, intentando con archivos locales');
            }
            
            // Si no hay datos del file explorer, usar archivos locales
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                if (isEggNOGFile(file.name)) {
                    handleEggnogFileSelect({ target: { files: files } });
                } else {
                    console.log(`Archivo no compatible con EggNOG: ${file.name}`);
                }
            }
        }

        // Seleccionar archivo EggNOG desde el explorador
        function selectEggnogFileFromExplorer(fileName, filePath) {
            currentSelectedFile = { name: fileName };
            currentSelectedFilePath = filePath;
            
            const fileType = getEggNOGFileType(fileName);
            const typeNames = {
                'seed_orthologs': 'Seed Orthologs',
                'hits': 'Hits',
                'annotations': 'Anotaciones'
            };
            
            // Mostrar información del archivo
            document.getElementById('selectedEggnogFileName').textContent = fileName;
            document.getElementById('selectedEggnogFilePath').textContent = filePath;
