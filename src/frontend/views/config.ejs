<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .theme-glass-effect {
            background: rgba(167, 243, 208, 0.2);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .config-card { background: var(--tool-green-bg); border: 1px solid var(--tool-green-border); }
        .setting-item { background: var(--tool-blue-bg); border: 1px solid var(--tool-blue-border); }
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 60px;
            height: 34px;
        }
        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        input:checked + .slider {
            background-color: #10b981;
        }
        input:checked + .slider:before {
            transform: translateX(26px);
        }
    </style>
    <script src="/js/theme-manager.js"></script>
</head>
<body class="theme-bg-primary theme-text-primary from-green-50 to-blue-50 min-h-screen">
    <!-- Header -->
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold theme-text-primary mb-2">
                <i class="fas fa-cog text-green-600 mr-3"></i>
                Configuración
            </h1>
            <p class="theme-text-secondary">Personaliza tu experiencia en FungiGT</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Configuración Principal -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Configuración General -->
                <div class="config-card rounded-2xl theme-shadow-light-xl p-6">
                    <h2 class="text-xl font-semibold theme-text-primary mb-6 flex items-center">
                        <i class="fas fa-sliders-h text-green-600 mr-3"></i>
                        Configuración General
                    </h2>
                    
                    <div class="space-y-6">
                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Idioma de la Interfaz</h3>
                                    <p class="text-sm theme-text-secondary">Selecciona el idioma para la interfaz de usuario</p>
                                </div>
                                <div class="ml-4">
                                    <select class="form-select w-full">
                                        <option value="es" selected>Español</option>
                                        <option value="en">English</option>
                                        <option value="fr">Français</option>
                                        <option value="de">Deutsch</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Zona Horaria</h3>
                                    <p class="text-sm theme-text-secondary">Configura tu zona horaria local</p>
                                </div>
                                <div class="ml-4">
                                    <select class="form-select w-full">
                                        <option value="Europe/Madrid" selected>Europe/Madrid (UTC+1)</option>
                                        <option value="America/New_York">America/New_York (UTC-5)</option>
                                        <option value="America/Los_Angeles">America/Los_Angeles (UTC-8)</option>
                                        <option value="Asia/Tokyo">Asia/Tokyo (UTC+9)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Tema de la Interfaz</h3>
                                    <p class="text-sm theme-text-secondary">Cambiar entre tema claro y oscuro</p>
                                </div>
                                <div class="ml-4">
                                    <label class="toggle-switch">
                                        <input type="checkbox" id="darkModeToggle">
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Animaciones de Interfaz</h3>
                                    <p class="text-sm theme-text-secondary">Habilitar o deshabilitar animaciones en la interfaz</p>
                                </div>
                                <div class="ml-4">
                                    <label class="toggle-switch">
                                        <input type="checkbox" id="animationsToggle" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Configuración de Análisis -->
                <div class="config-card rounded-2xl theme-shadow-light-xl p-6">
                    <h2 class="text-xl font-semibold theme-text-primary mb-6 flex items-center">
                        <i class="fas fa-microscope text-green-600 mr-3"></i>
                        Configuración de Análisis
                    </h2>
                    
                    <div class="space-y-6">
                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Límite de Procesos Concurrentes</h3>
                                    <p class="text-sm theme-text-secondary">Número máximo de análisis simultáneos</p>
                                </div>
                                <div class="ml-4">
                                    <input type="number" value="3" min="1" max="10" class="form-input w-20">
                                </div>
                            </div>
                        </div>

                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Auto-limpieza de Archivos Temporales</h3>
                                    <p class="text-sm theme-text-secondary">Eliminar archivos temporales después de completar análisis</p>
                                </div>
                                <div class="ml-4">
                                    <label class="toggle-switch">
                                        <input type="checkbox" id="autoCleanupToggle" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Calidad Mínima de Genomas</h3>
                                    <p class="text-sm theme-text-secondary">Umbral de calidad para aceptar genomas en análisis</p>
                                </div>
                                <div class="ml-4">
                                    <select class="form-select w-full">
                                        <option value="high" selected>Alta (>95%)</option>
                                        <option value="medium">Media (>85%)</option>
                                        <option value="low">Baja (>70%)</option>
                                        <option value="any">Cualquiera</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Configuración de Notificaciones -->
                <div class="config-card rounded-2xl theme-shadow-light-xl p-6">
                    <h2 class="text-xl font-semibold theme-text-primary mb-6 flex items-center">
                        <i class="fas fa-bell text-green-600 mr-3"></i>
                        Notificaciones
                    </h2>
                    
                    <div class="space-y-6">
                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Notificaciones por Email</h3>
                                    <p class="text-sm theme-text-secondary">Recibir notificaciones sobre el estado de los análisis</p>
                                </div>
                                <div class="ml-4">
                                    <label class="toggle-switch">
                                        <input type="checkbox" id="emailNotificationsToggle" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Notificaciones del Navegador</h3>
                                    <p class="text-sm theme-text-secondary">Mostrar notificaciones en el navegador web</p>
                                </div>
                                <div class="ml-4">
                                    <label class="toggle-switch">
                                        <input type="checkbox" id="browserNotificationsToggle">
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="setting-item rounded-lg p-4">
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <h3 class="font-medium theme-text-primary">Resumen Semanal</h3>
                                    <p class="text-sm theme-text-secondary">Recibir resumen semanal de actividad</p>
                                </div>
                                <div class="ml-4">
                                    <label class="toggle-switch">
                                        <input type="checkbox" id="weeklyReportToggle" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel Lateral -->
            <div class="space-y-6">
                <!-- Configuración Rápida -->
                <div class="config-card rounded-2xl theme-shadow-light-xl p-6">
                    <h3 class="text-lg font-semibold theme-text-primary mb-4">
                        <i class="fas fa-bolt text-green-600 mr-2"></i>
                        Configuración Rápida
                    </h3>
                    <div class="space-y-3">
                        <button class="w-full text-left p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-palette theme-text-secondary mr-2"></i>
                            <span class="text-sm">Personalizar Tema</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-sync theme-text-secondary mr-2"></i>
                            <span class="text-sm">Sincronizar Configuración</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-undo theme-text-secondary mr-2"></i>
                            <span class="text-sm">Restaurar Valores por Defecto</span>
                        </button>
                    </div>
                </div>

                <!-- Información del Sistema -->
                <div class="config-card rounded-2xl theme-shadow-light-xl p-6">
                    <h3 class="text-lg font-semibold theme-text-primary mb-4">
                        <i class="fas fa-info-circle text-green-600 mr-2"></i>
                        Información del Sistema
                    </h3>
                    <div class="space-y-3">
                        <div class="flex justify-between">
                            <span class="text-sm theme-text-secondary">Versión</span>
                            <span class="text-sm font-medium">v2.1.0</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-sm theme-text-secondary">Última Actualización</span>
                            <span class="text-sm font-medium">15 Dic 2024</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-sm theme-text-secondary">Espacio Usado</span>
                            <span class="text-sm font-medium">2.3 GB</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-sm theme-text-secondary">Análisis Realizados</span>
                            <span class="text-sm font-medium">127</span>
                        </div>
                    </div>
                </div>

                <!-- Herramientas Avanzadas -->
                <div class="config-card rounded-2xl theme-shadow-light-xl p-6">
                    <h3 class="text-lg font-semibold theme-text-primary mb-4">
                        <i class="fas fa-tools text-green-600 mr-2"></i>
                        Herramientas Avanzadas
                    </h3>
                    <div class="space-y-3">
                        <button class="w-full text-left p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-download theme-text-secondary mr-2"></i>
                            <span class="text-sm">Exportar Configuración</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-upload theme-text-secondary mr-2"></i>
                            <span class="text-sm">Importar Configuración</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-lg hover:theme-bg-secondary transition-colors duration-200">
                            <i class="fas fa-broom theme-text-secondary mr-2"></i>
                            <span class="text-sm">Limpiar Caché</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="mt-8 flex justify-between items-center">
            <div class="flex space-x-4">
                <button class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-200">
                    <i class="fas fa-save mr-2"></i>
                    Guardar Configuración
                </button>
                <button class="bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-200">
                    <i class="fas fa-undo mr-2"></i>
                    Deshacer Cambios
                </button>
            </div>
            <div>
                <button class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-200">
                    <i class="fas fa-trash mr-2"></i>
                    Restablecer Todo
                </button>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script>
        // Funcionalidad para los toggles
        document.querySelectorAll('.toggle-switch input').forEach(toggle => {
            toggle.addEventListener('change', function() {
                console.log(`Toggle ${this.id} cambiado a:`, this.checked);
            });
        });

        // Funcionalidad para los selects
        document.querySelectorAll('select').forEach(select => {
            select.addEventListener('change', function() {
                console.log(`Select ${this.name || 'unnamed'} cambiado a:`, this.value);
            });
        });

        // Funcionalidad para botones
        document.querySelectorAll('button').forEach(button => {
            button.addEventListener('click', function() {
                const text = this.textContent.trim();
                if (text.includes('Guardar')) {
                    alert('Configuración guardada exitosamente');
                } else if (text.includes('Deshacer')) {
                    alert('Cambios deshechados');
                } else if (text.includes('Restablecer')) {
                    if (confirm('¿Estás seguro de que quieres restablecer toda la configuración?')) {
                        alert('Configuración restablecida a valores por defecto');
                    }
                } else if (text.includes('Exportar')) {
                    alert('Funcionalidad de exportar en desarrollo');
                } else if (text.includes('Importar')) {
                    alert('Funcionalidad de importar en desarrollo');
                } else if (text.includes('Limpiar')) {
                    alert('Caché limpiado exitosamente');
                }
            });
        });

        // Cerrar menú de perfil al hacer clic fuera
        document.addEventListener('click', function(event) {
            const profileMenu = document.getElementById('profileMenu');
            if (profileMenu) {
                const profileButton = profileMenu.previousElementSibling;
                
                if (!profileButton.contains(event.target) && !profileMenu.contains(event.target)) {
                    profileMenu.classList.add('hidden');
                }
            }
        });

        // Funcionalidad para notificaciones del navegador
        document.getElementById('browserNotificationsToggle').addEventListener('change', function() {
            if (this.checked) {
                if ("Notification" in window) {
                    if (Notification.permission === "granted") {
                        new Notification("FungiGT", {
                            body: "Notificaciones del navegador activadas",
                            icon: "/logo1.png"
                        });
                    } else if (Notification.permission !== "denied") {
                        Notification.requestPermission().then(permission => {
                            if (permission === "granted") {
                                new Notification("FungiGT", {
                                    body: "Notificaciones del navegador activadas",
                                    icon: "/logo1.png"
                                });
                            }
                        });
                    }
                }
            }
        });
    </script>
</body>
</html> 