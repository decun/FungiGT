    <!-- Script para mostrar el comando de BRAKER3 -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const showCommandBtn = document.getElementById('showBraker3CommandBtn');
            const commandDisplay = document.getElementById('braker3CommandDisplay');
            const commandPre = document.getElementById('braker3DockerCommand');
            
            if (showCommandBtn) {
                showCommandBtn.addEventListener('click', function() {
                    // Recopilar datos del formulario
                    const species = document.getElementById('brakerSpecies').value || 'nombre_especie';
                    const genome = document.getElementById('brakerGenomeFile').value || 'genoma.fna';
                    const bam = document.getElementById('brakerBamFile')?.value || '';
                    const protSeq = document.getElementById('brakerProtSeqFile')?.value || '';
                    const threads = document.getElementById('brakerThreads').value || '4';
                    const inputFolder = document.getElementById('braker3InputFolderPath').value || 'C:/ruta/a/carpeta/entrada';
                    const outputFolder = document.getElementById('braker3OutputFolderPath').value || 'C:/ruta/a/carpeta/salida';
                    
                    // Recopilar flags seleccionados
                    const flagCheckboxes = document.querySelectorAll('input[name="flagsBRAKER3"]:checked');
                    const flags = Array.from(flagCheckboxes).map(cb => cb.value).join(' ');
                    
                    // Convertir rutas de Windows a formato Docker
                    const dockerInputPath = inputFolder.replace(/\\/g, '/');
                    const dockerOutputPath = outputFolder.replace(/\\/g, '/');
                    
                    // Construir el comando de Docker
                    let command = `docker run --rm \\
  -v "${dockerInputPath}:/input" \\
  -v "${dockerOutputPath}:/output" \\
  teambraker/braker3:latest \\
  braker.pl \\
  --species=${species} \\
  --genome=/input/${genome} \\
  --threads=${threads}`;
                    
                    // Agregar parámetros opcionales
                    if (bam && bam.trim() !== '') {
                        command += ` \\\n  --bam=/input/${bam}`;
                    }
                    
                    if (protSeq && protSeq.trim() !== '') {
                        command += ` \\\n  --prot_seq=/input/${protSeq}`;
                    }
                    
                    // Agregar flags adicionales
                    if (flags && flags.trim() !== '') {
                        command += ` \\\n  ${flags}`;
                    }
                    
                    // Agregar directorio de trabajo
                    command += ` \\\n  --workingdir=/output`;
                    
                    // Mostrar el comando
                    commandPre.textContent = command;
                    commandDisplay.classList.toggle('hidden');
                });
            }
        });
    </script>

    <!-- Script para funcionalidad de Funannotate -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Manejar cambio de workflow de Funannotate
            const workflowSelector = document.getElementById('funannotateWorkflow');
            const predictOptions = document.getElementById('funannotatePredictOptions');
            const annotateOptions = document.getElementById('funannotateAnnotateOptions');
            const submitText = document.getElementById('funannotateSubmitText');

            function handleWorkflowChange() {
                const workflow = workflowSelector.value;
                
                // Ocultar todas las opciones específicas
                predictOptions.style.display = 'none';
                annotateOptions.style.display = 'none';
                
                // Mostrar opciones según el workflow seleccionado
                if (workflow === 'predict') {
                    predictOptions.style.display = 'block';
                    submitText.textContent = 'Ejecutar Funannotate Predict';
                } else if (workflow === 'annotate') {
                    annotateOptions.style.display = 'block';
                    submitText.textContent = 'Ejecutar Funannotate Annotate';
                } else if (workflow === 'compare') {
                    submitText.textContent = 'Ejecutar Funannotate Compare';
                }
            }

            if (workflowSelector) {
                workflowSelector.addEventListener('change', handleWorkflowChange);
                handleWorkflowChange(); // Ejecutar al cargar
            }

            // Función para monitorear progreso de Funannotate
            function monitorFunannotateProgress(uniqueId) {
                if (window.funannotateProgressSource) {
                    window.funannotateProgressSource.close();
                }
                
                window.funannotateProgressSource = new EventSource('http://localhost:3005/funannotate-progress-stream');
                
                window.funannotateProgressSource.onmessage = function(event) {
                    const data = JSON.parse(event.data);
                    
                    // Actualizar progreso en la tabla
                    const progressBar = document.querySelector(`#progress-${uniqueId}`);
                    const progressText = document.querySelector(`#progressText-${uniqueId}`);
                    const statusCell = progressText.closest('tr').querySelector('td:nth-child(2) span');
                    
                    if (progressBar && progressText) {
                        progressBar.style.width = `${data.progress}%`;
                        progressText.textContent = `${data.progress}%`;
                        
                        // Actualizar estado visual
                        if (data.progress < 30) {
                            statusCell.textContent = 'Preparando análisis';
                            statusCell.className = 'px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800';
                        } else if (data.progress < 80) {
                            statusCell.textContent = 'Ejecutando Funannotate';
                            statusCell.className = 'px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-orange-100 text-orange-800';
                        } else {
                            statusCell.textContent = 'Finalizando';
                            statusCell.className = 'px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800';
                        }
                    }
                    
                    // Cerrar conexión cuando llegue a 100%
                    if (data.progress >= 100) {
                        console.log('Proceso Funannotate completado al 100%, cerrando conexión SSE');
                        window.funannotateProgressSource.close();
                        window.funannotateProgressSource = null;
                        
                        // Actualizar estado final
                        statusCell.textContent = 'Completado';
                        statusCell.className = 'px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800';
                        
                        // Agregar botones de acción
                        const actionsCell = document.getElementById(`actions-${uniqueId}`);
                        const outputFolder = document.getElementById('funannotateOutputFolderPath').value;
                        actionsCell.innerHTML = `
                            <div class="flex space-x-2">
                                <button class="view-results-btn bg-blue-500 hover:bg-blue-600 text-white px-2 py-1 rounded text-xs" data-output="${outputFolder}">
                                    Ver Resultados
                                </button>
                                <button class="download-results-btn bg-green-500 hover:bg-green-600 text-white px-2 py-1 rounded text-xs" data-output="${outputFolder}">
                                    Descargar
                                </button>
                            </div>
                        `;
                    }
                };
                
                window.funannotateProgressSource.onerror = function(error) {
                    console.error('Error en la conexión SSE de Funannotate:', error);
                    window.funannotateProgressSource.close();
                };
            }

            // Manejo del formulario de Funannotate
            const funannotateForm = document.getElementById('funannotateForm');
            if (funannotateForm) {
                funannotateForm.addEventListener('submit', function(event) {
                    event.preventDefault();
                    
                    const workflow = document.getElementById('funannotateWorkflow').value;
                    const species = document.getElementById('funannotateSpecies').value;
                    const input = document.getElementById('funannotateInput').value;
                    const cpus = document.getElementById('funannotateCpus').value;
                    const inputFolder = document.getElementById('funannotateInputFolderPath').value;
                    const outputFolder = document.getElementById('funannotateOutputFolderPath').value;
                    
                    // Validación básica
                    if (!species || !input || !inputFolder || !outputFolder) {
                        alert('Por favor, completa todos los campos obligatorios de Funannotate.');
                        return;
                    }
                    
                    // Recopilar parámetros específicos del workflow
                    const data = {
                        species: species,
                        input: input,
                        cpus: cpus,
                        inputFolder: inputFolder,
                        outputFolder: outputFolder,
                        autoCleanHeaders: document.getElementById('funannotateAutoCleanHeaders').checked
                    };
                    
                    // Agregar parámetros específicos para predict
                    if (workflow === 'predict') {
                        const organism = document.getElementById('funannotateOrganism').value;
                        const busco_db = document.getElementById('funannotateBusco').value;
                        const ploidy = document.getElementById('funannotatePloidy').value;
                        const protein_evidence = document.getElementById('funannotateProtein').value;
                        const rna_bam = document.getElementById('funannotateRnaBam').value;
                        
                        if (organism) data.organism = organism;
                        if (busco_db) data.busco_db = busco_db;
                        if (ploidy) data.ploidy = ploidy;
                        if (protein_evidence) data.protein_evidence = protein_evidence;
                        if (rna_bam) data.rna_bam = rna_bam;
                        
                        // Agregar flags opcionales
                        data.optimize_augustus = document.getElementById('funannotateOptimizeAugustus').checked;
                        data.repeats2evm = document.getElementById('funannotateRepeats2evm').checked;
                        data.stringtie_FPKM = document.getElementById('funannotateStringtieFPKM').checked;
                    }
                    
                    // Agregar parámetros específicos para annotate
                    if (workflow === 'annotate') {
                        data.antismash = document.getElementById('funannotateAntismash').checked;
                        data.iprscan = document.getElementById('funannotateIprscan').checked;
                        data.phobius = document.getElementById('funannotatePhobius').checked;
                        data.signalp = document.getElementById('funannotateSignalp').checked;
                    }
                    
                    console.log('Request Data Funannotate:', data);
                    
                    // Agregar trabajo a la tabla
                    const uniqueId = addAnalysisToTable({
                        type: `Anotación (Funannotate ${workflow})`,
                        status: 'Procesando',
                        progress: 0
                    });
                    
                    // Iniciar monitoreo en tiempo real
                    monitorFunannotateProgress(uniqueId);
                    
                    // Enviar solicitud a la API
                    const endpoint = workflow === 'predict' ? '/predict' : 
                                   workflow === 'annotate' ? '/annotate' : '/compare';
                    
                    fetch(`http://localhost:3005${endpoint}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data)
                    })
                    .then(response => response.json())
                    .then(data => {
                        console.log('Success Funannotate:', data);
                    })
                    .catch((error) => {
                        console.error('Error Funannotate:', error);
                        
                        // Mostrar error en la interfaz
                        const statusCell = document.querySelector(`#progressText-${uniqueId}`).closest('tr').querySelector('td:nth-child(2) span');
                        statusCell.textContent = 'Error';
                        statusCell.className = 'px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800';
                        
                        // Cerrar conexión SSE en caso de error
                        if (window.funannotateProgressSource) {
                            window.funannotateProgressSource.close();
                        }
                        
                        alert('Error al ejecutar Funannotate: ' + error.message);
                    });
                });
            }

            // Función para subir archivos de Funannotate
            const uploadFunannotateButton = document.getElementById('uploadFunannotateButton');
            if (uploadFunannotateButton) {
                uploadFunannotateButton.addEventListener('click', function() {
                    const files = document.getElementById('funannotateFiles').files;
                    const inputFolder = document.getElementById('funannotateInputFolderPath').value;
                    const outputFolder = document.getElementById('funannotateOutputFolderPath').value;
                    
                    if (files.length === 0) {
                        alert('Selecciona al menos un archivo para subir a Funannotate');
                        return;
                    }
                    
                    if (!inputFolder || !outputFolder) {
                        alert('Por favor, ingresa las rutas completas de las carpetas de entrada y salida para Funannotate');
                        return;
                    }
                    
                    const formData = new FormData();
                    formData.append('inputFolderPath', inputFolder);
                    formData.append('outputFolderPath', outputFolder);
                    
                    for (let i = 0; i < files.length; i++) {
                        formData.append('files', files[i]);
                    }
                    
                    fetch('http://localhost:3005/upload-files', {
                        method: 'POST',
                        body: formData,
                    })
                    .then(response => response.json())
                    .then(data => {
                        console.log('Archivos Funannotate subidos con éxito:', data);
                        alert('Archivos subidos con éxito para Funannotate');
                    })
                    .catch(error => {
                        console.error('Error al subir archivos Funannotate:', error);
                        alert('Error al subir archivos para Funannotate');
                    });
                });
            }

            // Mostrar comando Docker para Funannotate
            const showFunannotateCommandBtn = document.getElementById('showFunannotateCommandBtn');
            const funannotateCommandDisplay = document.getElementById('funannotateCommandDisplay');
            const funannotateDockerCommand = document.getElementById('funannotateDockerCommand');

            if (showFunannotateCommandBtn) {
                showFunannotateCommandBtn.addEventListener('click', function() {
                    // Recopilar datos del formulario
                    const workflow = document.getElementById('funannotateWorkflow').value;
                    const species = document.getElementById('funannotateSpecies').value || 'Aspergillus_fumigatus';
                    const input = document.getElementById('funannotateInput').value || 'genome.fasta';
                    const cpus = document.getElementById('funannotateCpus').value || '4';
                    const inputFolder = document.getElementById('funannotateInputFolderPath').value || 'C:/ruta/a/carpeta/entrada';
                    const outputFolder = document.getElementById('funannotateOutputFolderPath').value || 'C:/ruta/a/carpeta/salida';
                    
                    // Convertir rutas de Windows a formato Docker
                    const dockerInputPath = inputFolder.replace(/\\/g, '/');
                    const dockerOutputPath = outputFolder.replace(/\\/g, '/');
                    
                    // Construir el comando de Docker
                    let command = `docker run --rm \\
  -v "${dockerInputPath}:/input" \\
  -v "${dockerOutputPath}:/output" \\
  nextgenusfs/funannotate:latest \\
  funannotate ${workflow} \\
  --input /input/${input} \\
  --species "${species}" \\
  --cpus ${cpus}`;
                    
                    if (workflow === 'predict') {
                        command += ` \\
  --out /output`;
                        
                        // Agregar parámetros opcionales para predict
                        const organism = document.getElementById('funannotateOrganism').value;
                        const busco_db = document.getElementById('funannotateBusco').value;
                        const ploidy = document.getElementById('funannotatePloidy').value;
                        const protein_evidence = document.getElementById('funannotateProtein').value;
                        const rna_bam = document.getElementById('funannotateRnaBam').value;
                        
                        if (organism && organism.trim() !== '') {
                            command += ` \\\n  --organism ${organism}`;
                        }
                        if (busco_db && busco_db.trim() !== '') {
                            command += ` \\\n  --busco_db ${busco_db}`;
                        }
                        if (ploidy && ploidy.trim() !== '' && ploidy !== '1') {
                            command += ` \\\n  --ploidy ${ploidy}`;
                        }
                        if (protein_evidence && protein_evidence.trim() !== '') {
                            command += ` \\\n  --protein_evidence /input/${protein_evidence}`;
                        }
                        if (rna_bam && rna_bam.trim() !== '') {
                            command += ` \\\n  --rna_bam /input/${rna_bam}`;
                        }
                        
                        // Agregar flags opcionales
                        if (document.getElementById('funannotateOptimizeAugustus').checked) {
                            command += ` \\\n  --optimize_augustus`;
                        }
                        if (document.getElementById('funannotateRepeats2evm').checked) {
                            command += ` \\\n  --repeats2evm`;
                        }
                        if (document.getElementById('funannotateStringtieFPKM').checked) {
                            command += ` \\\n  --stringtie_FPKM`;
                        }
                    }
                    
                    if (workflow === 'annotate') {
                        // Agregar flags opcionales para annotate
                        if (document.getElementById('funannotateAntismash').checked) {
                            command += ` \\\n  --antismash`;
                        }
                        if (document.getElementById('funannotateIprscan').checked) {
                            command += ` \\\n  --iprscan`;
                        }
                        if (document.getElementById('funannotatePhobius').checked) {
                            command += ` \\\n  --phobius`;
                        }
                        if (document.getElementById('funannotateSignalp').checked) {
                            command += ` \\\n  --signalp`;
                        }
                    }
                    
                    // Mostrar el comando
                    funannotateDockerCommand.textContent = command;
                    funannotateCommandDisplay.classList.toggle('hidden');
                });
            }
        });
    </script>
</body>

<%- include('partials/footer') %>