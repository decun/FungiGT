<%- include('partials/header') %>

<body class="theme-bg-primary theme-text-primary min-h-screen flex flex-col">
    <main class="flex-grow p-6">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row gap-6">
                <!-- Panel lateral: Explorador de archivos -->
                <div class="w-full md:w-1/3 lg:w-1/4">
                    <%- include('partials/file-explorer') %>
                </div>
                
                <!-- Panel principal -->
                <div class="w-full md:w-2/3 lg:w-3/4">
                    <h2 class="text-3xl font-bold mb-8 flex items-center theme-text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h6m-6 4h6m-7 4h8m-8 4h8M7 5h10a2 2 0 012 2v14a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2z" />
                        </svg>
                        Anotador de Genomas y Control de Calidad
                    </h2>

                    <!-- Selector para elegir entre BRAKER3, CheckM, o ambas -->
                    <div class="theme-bg-primary p-6 rounded-xl theme-shadow-light-lg mb-8 border theme-border">
                        <h3 class="text-xl font-semibold mb-4 flex items-center theme-text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4" />
                            </svg>
                            Seleccionar Herramienta
                        </h3>
                        <div class="mt-4">
                            <label class="block text-sm font-medium theme-text-secondary mb-3">
                                Elige la herramienta que deseas utilizar:
                            </label>
                            <select id="toolSelector" class="form-select w-full">
                                <option value="checkm">CheckM - Control de Calidad</option>
                                <option value="braker3">BRAKER3 - Anotación de Genes</option>
                                <option value="funannotate">Funannotate - Anotación Funcional Completa</option>
                                <option value="both">Múltiples Herramientas</option>
                            </select>
                        </div>
                    </div>

                    <!-- Configuración de CheckM -->
                    <div id="checkMConfig" class="theme-bg-primary p-8 rounded-xl theme-shadow-light-lg mb-8 border theme-border" style="display:none;">
                        <div class="border-l-4 border-green-500 pl-6 mb-6">
                            <h3 class="text-2xl font-semibold mb-2 flex items-center theme-text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-3 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                                Configuración de CheckM
                        </h3>
                            <p class="theme-text-secondary text-sm">Herramienta para evaluar la calidad y completitud de genomas</p>
                        </div>
                        
                        <form id="checkMForm" class="space-y-6">
                            <!-- Configuración Principal -->
                            <div class="theme-bg-secondary p-6 rounded-lg">
                                <h4 class="text-lg font-semibold mb-4 theme-text-primary">Configuración Principal</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                        Tipo de Workflow
                                    </label>
                                        <select id="workflowType" name="workflowType" class="form-select w-full">
                                        <option value="lineage_wf">Lineage Workflow</option>
                                        <option value="taxonomy_wf">Taxonomy Workflow</option>
                                        <option value="qa">Quality Assessment</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                        Número de Hilos (-t)
                                    </label>
                                        <input type="number" id="threadsCheckM" name="threads" 
                                               class="form-input w-full" 
                                               min="1" max="32" value="8" required />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                        Extensión de Archivo (-x)
                                    </label>
                                        <input type="text" id="fileExtensionCheckM" name="fileExtension" 
                                               class="w-full p-3 border theme-border rounded-lg theme-bg-tertiary theme-text-secondary theme-input" 
                                               value="fna" readonly />
                                </div>
                                </div>
                            </div>

                            <!-- Configuración de Rutas -->
                            <div class="tool-card-blue">
                                <h4 class="text-lg font-semibold mb-4 tool-text-blue">Configuración de Rutas</h4>
                                <div class="grid grid-cols-1 gap-6">
                                <div>
                                        <label class="flex items-center text-sm font-medium theme-text-secondary mb-2">
                                        Ruta de entrada (carpeta con genomas)
                                            <div class="relative ml-2 group">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 cursor-help" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                                                    <div class="text-center">
                                                        <div class="font-semibold mb-1">Formato para CheckM:</div>
                                                        <div>Windows: C:\ruta\completa\carpeta</div>
                                                        <div>Linux/Mac: /ruta/completa/carpeta</div>
                                                        <div class="mt-1 text-yellow-300">Ejemplo: C:\Memoriacosas\FungiGT\data\raw\genomes</div>
                                                    </div>
                                                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-gray-800"></div>
                                                </div>
                                            </div>
                                    </label>
                                    <input type="text" id="checkMInputFolderPath" name="inputFolderPath" 
                                               class="form-input w-full" 
                                               value="C:\Memoriacosas\FungiGT\data\raw\genomes" 
                                               placeholder="Ej: C:\Memoriacosas\FungiGT\data\raw\genomes" />
                                        <p class="text-xs theme-text-muted mt-1">Los genomas serán tomados de esta carpeta</p>
                                </div>
                                <div>
                                        <label class="flex items-center text-sm font-medium theme-text-secondary mb-2">
                                        Ruta de salida (resultados)
                                            <div class="relative ml-2 group">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 cursor-help" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                                                    <div class="text-center">
                                                        <div class="font-semibold mb-1">Formato para CheckM:</div>
                                                        <div>Windows: C:\ruta\completa\carpeta</div>
                                                        <div>Linux/Mac: /ruta/completa/carpeta</div>
                                                        <div class="mt-1 text-yellow-300">Los resultados se guardarán aquí</div>
                                                    </div>
                                                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-gray-800"></div>
                                                </div>
                                            </div>
                                    </label>
                                    <input type="text" id="checkMOutputFolderPath" name="outputFolderPath" 
                                               class="form-input w-full" 
                                               value="C:\Memoriacosas\FungiGT\data\results\quality_control" 
                                               placeholder="Ej: C:\Memoriacosas\FungiGT\data\results\quality_control" />
                                </div>
                            </div>
                                    </div>

                            <!-- Flags Adicionales -->
                            <div class="tool-card-yellow">
                                <h4 class="text-lg font-semibold mb-4 tool-text-yellow">Opciones Avanzadas</h4>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="flagReduce" name="flagsCheckM" value="--reduced_tree" 
                                               class="h-4 w-4 text-green-600 focus:ring-green-500 theme-border rounded theme-input">
                                        <label for="flagReduce" class="ml-3 text-sm theme-text-secondary font-medium">--reduced_tree</label>
                                    </div>
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="flagQuiet" name="flagsCheckM" value="--quiet" 
                                               class="h-4 w-4 text-green-600 focus:ring-green-500 theme-border rounded theme-input">
                                        <label for="flagQuiet" class="ml-3 text-sm theme-text-secondary font-medium">--quiet</label>
                                    </div>
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="flagTab" name="flagsCheckM" value="--tab_table" 
                                               class="h-4 w-4 text-green-600 focus:ring-green-500 theme-border rounded theme-input">
                                        <label for="flagTab" class="ml-3 text-sm theme-text-secondary font-medium">--tab_table</label>
                                </div>
                            </div>
                            </div>

                            <!-- Subida de Archivos -->
                            <div class="tool-card-green">
                                <h4 class="text-lg font-semibold mb-4 tool-text-green">Subir Archivos</h4>
                                <div class="space-y-4">
                                    <div>
                                <label class="block text-sm font-medium theme-text-secondary mb-2">
                                    Subir archivos .fna a la carpeta de entrada
                                </label>
                                        <input type="file" id="fnaFilesCheckM" name="fnaFiles" multiple accept=".fna" 
                                               class="w-full p-3 border theme-border rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100 theme-input" />
                                    </div>
                                    <button type="button" id="uploadCheckMButton" 
                                            class="inline-flex items-center btn-soft-green">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                    </svg>
                                    Subir Archivos
                                </button>
                            </div>
                                </div>

                            <!-- Botones de Acción -->
                            <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t theme-border">
                                <button type="button" id="showCommandBtn" 
                                        class="flex-1 btn-soft-blue">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5-6h3" />
                                    </svg>
                                    Mostrar Comando
                                </button>
                                <button type="submit" 
                                        class="flex-1 btn-soft-green">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h8m-9-4V8a2 2 0 012-2h8a2 2 0 012 2v2M7 16h10" />
                                    </svg>
                                    Ejecutar CheckM
                                </button>
                            </div>
                            
                            <div id="commandDisplay" class="mt-4 p-4 theme-bg-tertiary rounded-lg hidden">
                                <h5 class="font-semibold theme-text-primary mb-2">Comando Docker:</h5>
                                <pre id="dockerCommand" class="text-sm theme-text-primary whitespace-pre-wrap theme-bg-primary p-3 rounded border"></pre>
                            </div>
                        </form>
                    </div>

                    <!-- Configuración de BRAKER3 -->
                    <div id="braker3Config" class="theme-bg-primary p-8 rounded-xl theme-shadow-light-lg mb-8 border theme-border" style="display:none;">
                        <div class="border-l-4 border-purple-500 pl-6 mb-6">
                            <h3 class="text-2xl font-semibold mb-2 flex items-center theme-text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 mr-3 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z" />
                            </svg>
                                Configuración de BRAKER3
                        </h3>
                            <p class="theme-text-secondary text-sm">Herramienta para anotación automática de genes en genomas eucariotas</p>
                        </div>
                        
                        <form id="braker3Form" class="space-y-6">
                            <!-- Configuración Principal -->
                            <div class="theme-bg-secondary p-6 rounded-lg">
                                <h4 class="text-lg font-semibold mb-4 theme-text-primary">Configuración Principal</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                            Especie (--species) *
                                    </label>
                                        <input type="text" id="brakerSpecies" name="species" 
                                               class="form-input w-full" 
                                               placeholder="Ej: Aspergillus_fumigatus" required />
                                        <p class="text-xs theme-text-muted mt-1">Nombre de la especie (sin espacios)</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                            Archivo del Genoma (--genome) *
                                    </label>
                                        <input type="text" id="brakerGenomeFile" name="genome" 
                                               class="form-input w-full" 
                                               placeholder="Ej: genome.fna" required />
                                        <p class="text-xs theme-text-muted mt-1">Nombre del archivo del genoma</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                            Archivo BAM (--bam) <span class="text-gray-400 italic">(Opcional)</span>
                                    </label>
                                        <input type="text" id="brakerBamFile" name="bam" 
                                               class="form-input w-full" 
                                               placeholder="Ej: sample.bam" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                            Archivo de Proteínas (--prot_seq) <span class="text-gray-400 italic">(Opcional)</span>
                                    </label>
                                        <input type="text" id="brakerProtSeqFile" name="prot_seq" 
                                               class="form-input w-full" 
                                               placeholder="Ej: proteins.faa" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium theme-text-secondary mb-2">
                                            Número de Hilos (--threads) *
                                    </label>
                                        <input type="number" id="brakerThreads" name="threads" 
                                               class="form-input w-full" 
                                               min="1" max="32" value="4" required />
                                </div>
                                </div>
                            </div>

                            <!-- Configuración de Rutas -->
                            <div class="tool-card-purple p-6 rounded-lg">
                                <h4 class="text-lg font-semibold mb-4 theme-text-primary">Configuración de Rutas</h4>
                                <div class="grid grid-cols-1 gap-6">
                                <div>
                                        <label class="flex items-center text-sm font-medium theme-text-secondary mb-2">
                                            Ruta Completa de la Carpeta de Entrada *
                                            <div class="relative ml-2 group">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 cursor-help" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                                                    <div class="text-center">
                                                        <div class="font-semibold mb-1">Formato para BRAKER3:</div>
                                                        <div>Windows: C:/ruta/completa/carpeta</div>
                                                        <div>Linux/Mac: /ruta/completa/carpeta</div>
                                                        <div class="mt-1 text-yellow-300">¡Usar "/" en lugar de "\" para Windows!</div>
                                                        <div class="text-yellow-300">Ejemplo: C:/Memoriacosas/FungiGT/data/raw/genomes</div>
                                                    </div>
                                                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-gray-800"></div>
                                                </div>
                                            </div>
                                    </label>
                                        <input type="text" id="braker3InputFolderPath" name="inputFolderPath" 
                                               class="form-input w-full" 
                                               placeholder="Ej: C:/Memoriacosas/FungiGT/data/raw/genomes" required />
                                        <p class="text-xs theme-text-muted mt-1">Carpeta que contiene los archivos de entrada</p>
                                </div>
                                <div>
                                        <label class="flex items-center text-sm font-medium theme-text-secondary mb-2">
                                            Ruta Completa de la Carpeta de Salida *
                                            <div class="relative ml-2 group">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 cursor-help" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                                                    <div class="text-center">
                                                        <div class="font-semibold mb-1">Formato para BRAKER3:</div>
                                                        <div>Windows: C:/ruta/completa/carpeta</div>
                                                        <div>Linux/Mac: /ruta/completa/carpeta</div>
                                                        <div class="mt-1 text-yellow-300">Los resultados se guardarán aquí</div>
                                </div>
                                                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-gray-800"></div>
                            </div>
                                            </div>
                                </label>
                                        <input type="text" id="braker3OutputFolderPath" name="outputFolderPath" 
                                               class="form-input w-full" 
                                               placeholder="Ej: C:/Memoriacosas/FungiGT/data/results/annotation" required />
                                    </div>
                                    </div>
                                    </div>

                            <!-- Flags Adicionales -->
                            <div class="tool-card-yellow p-6 rounded-lg">
                                <h4 class="text-lg font-semibold mb-4 theme-text-primary">Opciones Avanzadas</h4>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="brakerSoftmasking" name="flagsBRAKER3" value="--softmasking" 
                                               class="h-4 w-4 text-purple-600 focus:ring-purple-500 theme-border rounded theme-input">
                                        <label for="brakerSoftmasking" class="ml-3 text-sm theme-text-secondary font-medium">--softmasking</label>
                                    </div>
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="brakerGff3" name="flagsBRAKER3" value="--gff3" 
                                               class="h-4 w-4 text-purple-600 focus:ring-purple-500 theme-border rounded theme-input">
                                        <label for="brakerGff3" class="ml-3 text-sm theme-text-secondary font-medium">--gff3</label>
                                    </div>
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="brakerFungus" name="flagsBRAKER3" value="--fungus" 
                                               class="h-4 w-4 text-purple-600 focus:ring-purple-500 theme-border rounded theme-input">
                                        <label for="brakerFungus" class="ml-3 text-sm theme-text-secondary font-medium">--fungus</label>
                                    </div>
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="brakerKeepCrf" name="flagsBRAKER3" value="--keepCrf" 
                                               class="h-4 w-4 text-purple-600 focus:ring-purple-500 theme-border rounded theme-input">
                                        <label for="brakerKeepCrf" class="ml-3 text-sm theme-text-secondary font-medium">--keepCrf</label>
                                </div>
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="brakerMakehub" name="flagsBRAKER3" value="--makehub" 
                                               class="h-4 w-4 text-purple-600 focus:ring-purple-500 theme-border rounded theme-input">
                                        <label for="brakerMakehub" class="ml-3 text-sm theme-text-secondary font-medium">--makehub</label>
                            </div>
                                    <div class="flex items-center p-3 theme-bg-primary rounded-lg border theme-border">
                                        <input type="checkbox" id="brakerUseExisting" name="flagsBRAKER3" value="--useexisting" 
                                               class="h-4 w-4 text-purple-600 focus:ring-purple-500 theme-border rounded theme-input">
                                        <label for="brakerUseExisting" class="ml-3 text-sm theme-text-secondary font-medium">--useexisting</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Subida de Archivos -->
                            <div class="tool-card-purple p-6 rounded-lg">
                                <h4 class="text-lg font-semibold mb-4 theme-text-primary">Subir Archivos</h4>
                                <div class="space-y-4">
                                    <div>
                                <label class="block text-sm font-medium theme-text-secondary mb-2">
                                    Subir archivos a la carpeta de entrada
                                </label>
                                        <input type="file" id="fnaFilesBRAKER3" name="fnaFiles" multiple accept=".fna,.faa,.bam" 
