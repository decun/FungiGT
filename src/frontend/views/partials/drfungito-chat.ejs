<!-- Estilos específicos para Dr. Fungito -->
<style>
    .loading-spinner {
        animation: spin 1s linear infinite;
    }
    
    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    
    .markdown-content h1, .markdown-content h2, .markdown-content h3 {
        margin-top: 0.5rem;
        margin-bottom: 0.25rem;
    }
    
    .markdown-content strong {
        font-weight: 600;
        color: var(--color-text-primary, #065f46);
    }
    
    [data-theme="dark"] .markdown-content strong {
        color: #10b981;
    }
    
    .markdown-content em {
        font-style: italic;
        color: var(--color-text-secondary, #047857);
    }
    
    [data-theme="dark"] .markdown-content em {
        color: #6ee7b7;
    }
    
    .markdown-content code {
        font-family: 'Courier New', monospace;
        font-size: 0.875rem;
        background-color: var(--color-bg-tertiary, #f3f4f6);
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
    }
    
    [data-theme="dark"] .markdown-content code {
        background-color: #374151;
        color: #e5e7eb;
    }
    
    .markdown-content li {
        margin-bottom: 0.25rem;
    }
    
    .markdown-content a {
        transition: color 0.2s ease;
    }
    
    .markdown-content a:hover {
        color: #059669 !important;
    }
    
    /* Ventana redimensionable */
    .resizable-panel {
        resize: both;
        overflow: hidden;
        min-width: 320px;
        min-height: 400px;
        max-width: 90vw;
        max-height: 90vh;
    }
    
    .resize-handle {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 20px;
        height: 20px;
        background: linear-gradient(-45deg, transparent 30%, #10b981 30%, #10b981 40%, transparent 40%, transparent 60%, #10b981 60%, #10b981 70%, transparent 70%);
        cursor: nw-resize;
        opacity: 0.6;
        transition: opacity 0.2s;
    }
    
    .resize-handle:hover {
        opacity: 1;
    }
    
    [data-theme="dark"] .resize-handle {
        background: linear-gradient(-45deg, transparent 30%, #6ee7b7 30%, #6ee7b7 40%, transparent 40%, transparent 60%, #6ee7b7 60%, #6ee7b7 70%, transparent 70%);
    }
    
    /* Asegurar que hidden funcione correctamente */
    #drFungitoPanel.hidden {
        display: none !important;
    }
    
    #drFungitoPanel:not(.hidden) {
        display: flex !important;
        flex-direction: column !important;
    }
</style>

<!-- DrFungito - Asistente Genómico Inteligente -->
<div class="fixed bottom-4 right-4 z-50">
    <!-- Botón principal con imagen de DrFungito -->
    <button id="drFungitoButton" class="theme-bg-primary text-white rounded-full w-16 h-16 flex items-center justify-center theme-shadow-light-lg hover:theme-shadow-light-xl transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-green-300 transform hover:scale-105 border-2 theme-border hover:border-green-300">
        <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-14 h-14 rounded-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
        <div class="w-14 h-14 rounded-full bg-green-500 flex items-center justify-center text-white font-bold text-xl hidden">🍄</div>
    </button>
    
    <!-- Panel de chat draggable y redimensionable -->
    <div id="drFungitoPanel" class="hidden fixed theme-bg-primary theme-text-primary rounded-2xl theme-shadow-light-2xl border theme-border resizable-panel" style="bottom: 20px; right: 0px; z-index: 1000; width: 384px; height: 500px;">
        <!-- Header del chat - Draggable -->
        <div id="drFungitoHeader" class="bg-gradient-to-r from-green-500 to-green-600 text-white p-4 rounded-t-2xl cursor-move select-none">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-10 h-10 rounded-full object-cover border-2 border-white" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="w-10 h-10 rounded-full bg-green-700 border-2 border-white flex items-center justify-center text-white font-bold hidden">🍄</div>
                    <div>
                        <h3 class="font-bold text-lg">Dr. Fungito AI</h3>
                        <p class="text-green-100 text-sm">Análisis Genómico + Imágenes IA</p>
                    </div>
                </div>
                <div class="flex items-center space-x-2">
                    <!-- Indicador de estado de conexión -->
                    <div id="connectionStatus" class="w-2 h-2 rounded-full bg-yellow-400" title="Conectando..."></div>
                    <!-- Botón de cerrar -->
                    <button id="closeDrFungito" class="text-white hover:text-green-200 transition-colors" title="Cerrar">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Área de mensajes -->
        <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-3 theme-bg-secondary" style="min-height: 200px; max-height: calc(100% - 200px);">
            <div class="flex items-start space-x-2">
                <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-8 h-8 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 hidden">🍄</div>
                <div class="theme-bg-primary p-3 rounded-lg theme-theme-shadow-light-light border theme-border max-w-xs">
                    <p class="text-sm theme-text-primary">¡Hola! Soy Dr. Fungito con IA avanzada. Puedo analizar tus gráficos genómicos, generar reportes detallados y responder preguntas especializadas sobre hongos. ¿En qué puedo ayudarte?</p>
                </div>
            </div>
        </div>
        
        <!-- Botones de acción rápida -->
        <div class="px-4 py-2 theme-bg-secondary border-t theme-border">
            <div class="flex flex-wrap gap-2">
                <button class="quick-action-btn px-3 py-1 bg-blue-500 text-white text-xs rounded-full hover:bg-blue-600 transition-colors" data-action="memory">📊 Ver mi memoria</button>
                <button class="quick-action-btn px-3 py-1 bg-purple-500 text-white text-xs rounded-full hover:bg-purple-600 transition-colors" data-action="report">📄 Generar reporte</button>
                <button class="quick-action-btn px-3 py-1 bg-red-500 text-white text-xs rounded-full hover:bg-red-600 transition-colors" data-action="clear">🗑️ Limpiar memoria</button>
                <button class="quick-action-btn px-3 py-1 bg-orange-500 text-white text-xs rounded-full hover:bg-orange-600 transition-colors" data-action="help">❓ Ayuda</button>
            </div>
        </div>
        
        <!-- Input de mensaje -->
        <div class="p-4 theme-bg-primary border-t theme-border">
            <div class="flex space-x-2">
                <input type="text" id="userInput" placeholder="Escribe tu pregunta..." class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 text-gray-800 text-sm">
                <button id="sendMessage" class="bg-green-500 text-white p-2 rounded-lg hover:bg-green-600 transition-colors focus:outline-none focus:ring-2 focus:ring-green-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                    </svg>
                </button>
            </div>
        </div>
        
        <!-- Handle de redimensionamiento -->
        <div class="resize-handle" title="Redimensionar ventana"></div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const drFungitoButton = document.getElementById('drFungitoButton');
    const drFungitoPanel = document.getElementById('drFungitoPanel');
    const drFungitoHeader = document.getElementById('drFungitoHeader');
    const closeDrFungito = document.getElementById('closeDrFungito');
    const userInput = document.getElementById('userInput');
    const sendButton = document.getElementById('sendMessage');
    const chatMessages = document.getElementById('chatMessages');
    const connectionStatus = document.getElementById('connectionStatus');
    
    // Variables para dragging
    let isDragging = false;
    let dragOffsetX = 0;
    let dragOffsetY = 0;
    
    // URL del agente Dr. Fungito AI
    const drFungitoUrl = 'http://localhost:4009';
    
    // Verificar que todos los elementos estén disponibles
    console.log('🍄 [DEBUG] Elementos encontrados:');
    console.log('- drFungitoButton:', !!drFungitoButton);
    console.log('- drFungitoPanel:', !!drFungitoPanel);
    console.log('- closeDrFungito:', !!closeDrFungito);
    console.log('- drFungitoHeader:', !!drFungitoHeader);
    
    // Verificar estado de conexión al cargar
    checkConnectionStatus();
    
    // Toggle del panel (NO auto-close)
    drFungitoButton.addEventListener('click', () => {
        console.log('🍄 [DEBUG] Toggle botón clickeado');
        
        if (drFungitoPanel.classList.contains('hidden')) {
            // Abrir panel
            drFungitoPanel.classList.remove('hidden');
            drFungitoPanel.style.display = 'flex';
            userInput.focus();
            checkConnectionStatus();
            console.log('🍄 [DEBUG] Panel abierto');
        } else {
            // Cerrar panel
            drFungitoPanel.classList.add('hidden');
            drFungitoPanel.style.display = 'none';
            console.log('🍄 [DEBUG] Panel cerrado desde toggle');
        }
    });

    // Cerrar panel manualmente
    closeDrFungito.addEventListener('click', (e) => {
        console.log('🍄 [DEBUG] Botón cerrar clickeado');
        e.preventDefault();
        e.stopPropagation();
        
        // Múltiples métodos para asegurar que se cierre
        drFungitoPanel.classList.add('hidden');
        drFungitoPanel.style.display = 'none';
        
        // Double check
        setTimeout(() => {
            if (!drFungitoPanel.classList.contains('hidden')) {
                drFungitoPanel.classList.add('hidden');
            }
        }, 50);
        
        console.log('🍄 [DEBUG] Panel cerrado, clases:', drFungitoPanel.className);
    });
    
    // === FUNCIONALIDAD DE DRAG ===
    drFungitoHeader.addEventListener('mousedown', (e) => {
        isDragging = true;
        const rect = drFungitoPanel.getBoundingClientRect();
        dragOffsetX = e.clientX - rect.left;
        dragOffsetY = e.clientY - rect.top;
        
        drFungitoHeader.style.cursor = 'grabbing';
        document.addEventListener('mousemove', handleDrag);
        document.addEventListener('mouseup', stopDrag);
        
        e.preventDefault();
    });
    
    function handleDrag(e) {
        if (!isDragging) return;
        
        const x = e.clientX - dragOffsetX;
        const y = e.clientY - dragOffsetY;
        
        // Limitar a los bordes de la ventana
        const maxX = window.innerWidth - drFungitoPanel.offsetWidth;
        const maxY = window.innerHeight - drFungitoPanel.offsetHeight;
        
        const constrainedX = Math.max(0, Math.min(x, maxX));
        const constrainedY = Math.max(0, Math.min(y, maxY));
        
        drFungitoPanel.style.left = constrainedX + 'px';
        drFungitoPanel.style.top = constrainedY + 'px';
        drFungitoPanel.style.bottom = 'auto';
        drFungitoPanel.style.right = 'auto';
    }
    
    function stopDrag() {
        isDragging = false;
        drFungitoHeader.style.cursor = 'move';
        document.removeEventListener('mousemove', handleDrag);
        document.removeEventListener('mouseup', stopDrag);
    }
    
    // Botones de acción rápida
    document.querySelectorAll('.quick-action-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const action = this.dataset.action;
            handleQuickAction(action);
        });
    });
    
    // Función para verificar conexión con el agente
    async function checkConnectionStatus() {
        try {
            const response = await fetch(`${drFungitoUrl}/health`);
            if (response.ok) {
                connectionStatus.className = 'w-2 h-2 rounded-full bg-green-400';
                connectionStatus.title = 'Conectado';
            } else {
                connectionStatus.className = 'w-2 h-2 rounded-full bg-red-400';
                connectionStatus.title = 'Error de conexión';
            }
        } catch (error) {
            connectionStatus.className = 'w-2 h-2 rounded-full bg-red-400';
            connectionStatus.title = 'Sin conexión';
        }
    }
    
    // Función para renderizar markdown básico
    function renderMarkdown(text) {
        return text
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/`(.*?)`/g, '<code class="bg-gray-100 px-1 rounded text-sm">$1</code>')
            .replace(/### (.*?)$/gm, '<h3 class="font-bold text-lg mt-3 mb-2 text-green-600">$1</h3>')
            .replace(/## (.*?)$/gm, '<h2 class="font-bold text-xl mt-4 mb-2 text-green-700">$1</h2>')
            .replace(/# (.*?)$/gm, '<h1 class="font-bold text-2xl mt-4 mb-3 text-green-800">$1</h1>')
            .replace(/^\* (.*?)$/gm, '<li class="ml-4">• $1</li>')
            .replace(/^\- (.*?)$/gm, '<li class="ml-4">• $1</li>')
            .replace(/\n\n/g, '<br><br>')
            .replace(/\n/g, '<br>')
            .replace(/🔗 <a href="(.*?)"(.*?)>(.*?)<\/a>/g, '<a href="$1" target="_blank" class="text-blue-500 hover:text-blue-700 underline font-semibold">$3</a>');
    }
    
    // Función para manejar acciones rápidas
    async function handleQuickAction(action) {
        switch(action) {
            case 'memory':
                await showUserMemory();
                break;
            case 'report':
                await generateQuickReport();
                break;
            case 'clear':
                await clearUserMemory();
                break;
            case 'help':
                showHelp();
                break;
        }
    }
    
    // Función para mostrar memoria del usuario (versión corta como en la imagen)
    async function showUserMemory() {
        const loadingMessage = displayMessage('📊 Consultando tu memoria genómica...', false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/memory?limit=5`, {
                headers: {
                    'X-User-Id': getUserId()
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al obtener memoria');
            }
            
            const memoryData = await response.json();
            loadingMessage.remove();
            
            const memoryText = `🧠 **Tu Memoria Genómica:**\n\n` +
                `📷 **Imágenes analizadas:** ${memoryData.totalImages}\n` +
                `📄 **Reportes generados:** ${memoryData.totalReports}\n` +
                `📅 **Última actividad:** ${new Date(memoryData.lastActivity).toLocaleDateString('es-ES')}\n\n` +
                `**Últimas imágenes:**\n` +
                memoryData.images.slice(0, 3).map(img => 
                    `🔬 ${img.filename} (${img.analysisType})`
                ).join('\n') +
                (memoryData.totalReports > 0 ? `\n\n**Reportes disponibles:**\n` +
                memoryData.reports.slice(0, 2).map(report => 
                    `📄 ${report.title} - ${new Date(report.createdAt).toLocaleDateString('es-ES')}`
                ).join('\n') : '');
            
            displayMessage(memoryText);
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ Error al consultar tu memoria. Verifica la conexión con el agente IA.');
        }
    }
    
    // Función para generar reporte rápido
    async function generateQuickReport() {
        const loadingMessage = displayMessage('📄 Generando reporte profesional...', false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/generate-report`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                },
                body: JSON.stringify({
                    reportType: 'summary',
                    title: 'Reporte Rápido de Análisis Genómico',
                    includeAllImages: false,
                    generatePDF: true
                })
            });
            
            if (!response.ok) {
                throw new Error('Error al generar reporte');
            }
            
            const reportData = await response.json();
            loadingMessage.remove();
            
            if (reportData.success && reportData.pdfAvailable) {
                const reportMessage = `🎉 **¡Reporte PDF Generado!**\n\n` +
                    `📄 **${reportData.title}**\n` +
                    `📊 **${reportData.imageCount} imágenes**\n` +
                    `🔬 **Tipos:** ${reportData.analysisTypes.join(', ')}\n\n` +
                    `🔗 [📥 Descargar Reporte PDF](${drFungitoUrl}${reportData.downloadUrl})`;
                
                displayMessage(reportMessage);
            } else {
                displayMessage(`📄 **Reporte generado** (ID: ${reportData.reportId})\n\nRevisa la carpeta \`reports\` en el File Manager.`);
            }
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ **Error al generar reporte**\n\nAsegúrate de haber analizado algunas imágenes primero.');
        }
    }
    
    // Función para mostrar ayuda
    function showHelp() {
        const helpText = `🤖 **Dr. Fungito AI - Ayuda:**\n\n` +
            `**Funciones principales:**\n` +
            `🔬 Análisis automático de gráficos genómicos\n` +
            `📊 Interpretación de resultados (BinDash, eggNOG, CheckM)\n` +
            `📄 Generación de reportes PDF profesionales\n` +
            `🧠 Memoria contextual por usuario\n\n` +
            `**Tip:** ¡Usa los botones 🍄 en cada visualizador!`;
        
        displayMessage(helpText);
    }
    
    // Función para limpiar memoria del usuario
    async function clearUserMemory() {
        // Confirmar acción con el usuario
        if (!confirm('⚠️ ¿Estás seguro de que quieres limpiar toda tu memoria genómica?\n\nEsto eliminará:\n- Todas las imágenes analizadas\n- Todos los reportes generados\n- Todo el historial de chat\n\nEsta acción NO se puede deshacer.')) {
            return;
        }
        
        const loadingMessage = displayMessage('🗑️ Limpiando tu memoria genómica...', false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/clear-memory`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al limpiar memoria');
            }
            
            const result = await response.json();
            loadingMessage.remove();
            
            // Limpiar el chat visual también
            chatMessages.innerHTML = `
                <div class="flex items-start space-x-2">
                    <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-8 h-8 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 hidden">🍄</div>
                    <div class="theme-bg-primary p-3 rounded-lg theme-theme-shadow-light-light border theme-border max-w-xs">
                        <p class="text-sm theme-text-primary">¡Hola! Soy Dr. Fungito con IA avanzada. Puedo analizar tus gráficos genómicos, generar reportes detallados y responder preguntas especializadas sobre hongos. ¿En qué puedo ayudarte?</p>
                    </div>
                </div>
            `;
            
            const successText = `✅ **Memoria limpiada exitosamente**\n\n` +
                `🗑️ **Eliminado:**\n` +
                `📷 ${result.previousStats?.images || 0} imágenes\n` +
                `📄 ${result.previousStats?.reports || 0} reportes\n` +
                `💬 ${result.previousStats?.chats || 0} mensajes de chat\n\n` +
                `🆕 **Estado:** Memoria reiniciada\n` +
                `¡Listo para nuevos análisis!`;
            
            displayMessage(successText);
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ **Error al limpiar memoria**\n\nNo se pudo conectar con el agente IA. Verifica que el servicio esté funcionando.');
        }
    }
    
    // Función para mostrar mensajes en el chat
    function displayMessage(content, isUser = false, isLoading = false) {
        const messageDiv = document.createElement('div');
        messageDiv.className = 'flex items-start space-x-2';
        
        if (isUser) {
            messageDiv.className += ' flex-row-reverse space-x-reverse';
            messageDiv.innerHTML = `
                <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">U</div>
                <div class="bg-blue-500 text-white p-3 rounded-lg max-w-xs">
                    <p class="text-sm">${content}</p>
                </div>
            `;
        } else {
            const loadingIcon = isLoading ? '<div class="loading-spinner w-4 h-4 border-2 border-gray-300 border-t-green-500 rounded-full animate-spin inline-block mr-2"></div>' : '';
            const renderedContent = isLoading ? content : renderMarkdown(content);
            
            messageDiv.innerHTML = `
                <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-8 h-8 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 hidden">🍄</div>
                <div class="theme-bg-primary p-3 rounded-lg theme-theme-shadow-light-light border theme-border max-w-xs">
                    <div class="text-sm theme-text-primary markdown-content">
                        ${loadingIcon}${renderedContent}
                    </div>
                </div>
            `;
        }
        
        chatMessages.appendChild(messageDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return messageDiv;
    }
    
    // Función para enviar mensajes
    async function handleSendMessage() {
        const message = userInput.value.trim();
        if (!message) return;
        
        // Mostrar mensaje del usuario
        displayMessage(message, true);
        userInput.value = '';
        
        // Deshabilitar input mientras se procesa
        sendButton.disabled = true;
        userInput.disabled = true;
        
        // Mostrar indicador de carga
        const loadingMessage = document.createElement('div');
        loadingMessage.className = 'flex items-start space-x-2';
        loadingMessage.innerHTML = `
            <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-8 h-8 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 hidden">🍄</div>
            <div class="theme-bg-primary p-3 rounded-lg theme-theme-shadow-light-light border theme-border max-w-xs">
                <div class="text-sm theme-text-primary">🤔 Pensando...</div>
            </div>
        `;
        chatMessages.appendChild(loadingMessage);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        
        try {
            // Enviar a Dr. Fungito AI Agent
            const response = await fetch(`${drFungitoUrl}/chat`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                },
                body: JSON.stringify({
                    message: message,
                    includeMemoryContext: true
                })
            });
            
            if (!response.ok) {
                throw new Error(`Error del servidor: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Eliminar mensaje de carga
            loadingMessage.remove();
            
            // Mostrar respuesta del agente
            displayMessage(data.response, false);
            
        } catch (error) {
            console.error('Error al comunicarse con Dr. Fungito AI:', error);
            loadingMessage.remove();
            
            // Fallback a respuestas locales si el agente no está disponible
            const fallbackResponse = generateLocalResponse(message);
            displayMessage(`⚠️ Agente IA no disponible. Respuesta local:\n\n${fallbackResponse}`, false);
        } finally {
            // Rehabilitar input
            sendButton.disabled = false;
            userInput.disabled = false;
            userInput.focus();
        }
    }
    
    // Función para generar respuestas locales cuando el agente no está disponible
    function generateLocalResponse(message) {
        const lowerMessage = message.toLowerCase();
        
        if (lowerMessage.includes('hola') || lowerMessage.includes('buenas')) {
            return '🍄 ¡Hola! Soy Dr. Fungito AI. Conecta el agente en puerto 4009 para análisis inteligente completo.';
        } else if (lowerMessage.includes('reporte')) {
            return '📄 Para generar reportes necesito estar conectado al agente IA. Verifica que el servicio esté ejecutándose.';
        } else if (lowerMessage.includes('memoria')) {
            return '🧠 La memoria contextual requiere conexión al agente IA. Inicia el servicio Dr. Fungito.';
        } else {
            return '🤖 Dr. Fungito AI no está disponible. Conecta el agente en puerto 4009 para análisis inteligente de imágenes, generación automática de reportes y chat contextual avanzado.';
        }
    }
    
    // Función para obtener ID de usuario
    function getUserId() {
        let userId = localStorage.getItem('drfungito_user_id');
        if (!userId) {
            userId = 'user_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            localStorage.setItem('drfungito_user_id', userId);
        }
        return userId;
    }

    // Event listeners
    sendButton.addEventListener('click', handleSendMessage);
    userInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            handleSendMessage();
        }
    });

    // ELIMINADO: El auto-close que causaba problemas
    // Ya no se cierra automáticamente al hacer clic fuera
    
    // Verificar conexión periódicamente
    setInterval(checkConnectionStatus, 30000); // Cada 30 segundos
    
    // Función global para que los visualizadores envíen imágenes al Dr. Fungito
    window.sendImageToDrFungito = async function(imageUrl, analysisType = 'general', filename = 'visualizer_image') {
        try {
            const response = await fetch(`${drFungitoUrl}/analyze-from-visualizer`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                },
                body: JSON.stringify({
                    imageUrl,
                    analysisType,
                    filename,
                    userContext: `Imagen del visualizador ${analysisType}`
                })
            });
            
            if (!response.ok) {
                throw new Error('Error al enviar imagen al Dr. Fungito');
            }
            
            const result = await response.json();
            
            // Mostrar notificación de éxito
            if (window.Swal) {
                Swal.fire({
                    icon: 'success',
                    title: '🍄 Enviado a Dr. Fungito!',
                    text: 'La imagen ha sido analizada y guardada en tu memoria genómica.',
                    showConfirmButton: false,
                    timer: 3000,
                    toast: true,
                    position: 'top-end'
                });
            }
            
            // Abrir el panel de Dr. Fungito si está cerrado
            if (drFungitoPanel.classList.contains('hidden')) {
                drFungitoPanel.classList.remove('hidden');
            }
            
            // Mostrar el análisis en el chat
            displayMessage(`📊 **Análisis completado para: ${filename}**\n\n${result.analysis}`);
            
            return result;
            
        } catch (error) {
            console.error('Error al enviar imagen a Dr. Fungito:', error);
            
            // Mostrar error
            if (window.Swal) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'No se pudo enviar la imagen a Dr. Fungito. Verifica que el agente esté funcionando.',
                    toast: true,
                    position: 'top-end',
                    timer: 3000,
                    showConfirmButton: false
                });
            }
            
            throw error;
        }
    };
});
</script> 