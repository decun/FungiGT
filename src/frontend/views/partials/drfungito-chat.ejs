<!-- DrFungito - Asistente Genómico Inteligente -->
<div class="fixed bottom-4 right-4 z-50">
    <!-- Botón principal con imagen de DrFungito -->
    <button id="drFungitoButton" class="theme-bg-primary text-white rounded-full w-16 h-16 flex items-center justify-center theme-shadow-light-lg hover:theme-shadow-light-xl transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-green-300 transform hover:scale-105 border-2 theme-border hover:border-green-300">
        <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-14 h-14 rounded-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
        <div class="w-14 h-14 rounded-full bg-green-500 flex items-center justify-center text-white font-bold text-xl hidden">🍄</div>
    </button>
    
    <!-- Panel de chat -->
    <div id="drFungitoPanel" class="hidden absolute bottom-20 right-0 theme-bg-primary theme-text-primary rounded-2xl theme-shadow-light-2xl w-96 max-h-[500px] border theme-border overflow-hidden">
        <!-- Header del chat -->
        <div class="bg-gradient-to-r from-green-500 to-green-600 text-white p-4 rounded-t-2xl">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-10 h-10 rounded-full object-cover border-2 border-white" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="w-10 h-10 rounded-full bg-green-700 border-2 border-white flex items-center justify-center text-white font-bold hidden">🍄</div>
                    <div>
                        <h3 class="font-bold text-lg">Dr. Fungito AI</h3>
                        <p class="text-green-100 text-sm">Análisis Genómico + Imágenes IA</p>
                    </div>
                </div>
                <div class="flex items-center space-x-2">
                    <!-- Indicador de estado de conexión -->
                    <div id="connectionStatus" class="w-2 h-2 rounded-full bg-yellow-400" title="Conectando..."></div>
                    <button id="closeDrFungito" class="text-white hover:text-green-200 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Área de mensajes -->
        <div id="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-3 max-h-80 theme-bg-secondary">
            <div class="flex items-start space-x-2">
                <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-8 h-8 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 hidden">🍄</div>
                <div class="theme-bg-primary p-3 rounded-lg theme-theme-shadow-light-light border theme-border max-w-xs">
                    <p class="text-sm theme-text-primary">¡Hola! Soy Dr. Fungito con IA avanzada. Puedo analizar tus gráficos genómicos, generar reportes detallados y responder preguntas especializadas sobre hongos. ¿En qué puedo ayudarte?</p>
                </div>
            </div>
            

        </div>
        
        <!-- Input de mensaje -->
        <div class="p-4 border-t theme-border theme-bg-primary rounded-b-2xl">
            <div class="flex space-x-2">
                <input type="text" 
                       id="userInput" 
                       class="flex-grow px-3 py-2 pr-24 border theme-border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 text-sm theme-input" 
                       placeholder="Pregúntame sobre genómica o pide un reporte..." 
                       maxlength="500" />
                <button id="sendMessage" 
                        class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition-colors focus:outline-none focus:ring-2 focus:ring-green-500 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                    </svg>
                </button>
            </div>
            
            <!-- Botones de acceso rápido - Reposicionados debajo del input -->
            <div class="flex flex-wrap gap-2 mt-3 justify-center">
                <button class="quick-action-btn bg-blue-100 text-blue-800 px-3 py-2 rounded-lg text-xs hover:bg-blue-200 transition-colors flex items-center space-x-1" data-action="memory">
                    <span>📊</span>
                    <span>Ver mi memoria</span>
                </button>
                <button class="quick-action-btn bg-purple-100 text-purple-800 px-3 py-2 rounded-lg text-xs hover:bg-purple-200 transition-colors flex items-center space-x-1" data-action="report">
                    <span>📄</span>
                    <span>Generar reporte</span>
                </button>
                <button class="quick-action-btn bg-red-100 text-red-800 px-3 py-2 rounded-lg text-xs hover:bg-red-200 transition-colors flex items-center space-x-1" data-action="clear">
                    <span>🗑️</span>
                    <span>Borrar memoria</span>
                </button>
                <button class="quick-action-btn bg-green-100 text-green-800 px-3 py-2 rounded-lg text-xs hover:bg-green-200 transition-colors flex items-center space-x-1" data-action="help">
                    <span>❓</span>
                    <span>Ayuda</span>
                </button>
            </div>
            
            <div class="mt-2 text-xs theme-text-muted text-center">
                🧠 IA Avanzada: Análisis de imágenes, reportes inteligentes, memoria contextual
            </div>
        </div>
    </div>
</div>

<!-- Script para DrFungito con IA -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const drFungitoButton = document.getElementById('drFungitoButton');
    const drFungitoPanel = document.getElementById('drFungitoPanel');
    const closeDrFungito = document.getElementById('closeDrFungito');
    const userInput = document.getElementById('userInput');
    const sendButton = document.getElementById('sendMessage');
    const chatMessages = document.getElementById('chatMessages');
    const connectionStatus = document.getElementById('connectionStatus');
    
    // URL del agente Dr. Fungito AI
    const drFungitoUrl = 'http://localhost:4009';
    
    // Verificar estado de conexión al cargar
    checkConnectionStatus();
    
    // Toggle del panel
    drFungitoButton.addEventListener('click', () => {
        drFungitoPanel.classList.toggle('hidden');
        if (!drFungitoPanel.classList.contains('hidden')) {
            userInput.focus();
            checkConnectionStatus();
        }
    });

    // Cerrar panel
    closeDrFungito.addEventListener('click', () => {
        drFungitoPanel.classList.add('hidden');
    });
    
    // Botones de acción rápida
    document.querySelectorAll('.quick-action-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const action = this.dataset.action;
            handleQuickAction(action);
        });
    });
    
    // Función para verificar conexión con el agente
    async function checkConnectionStatus() {
        try {
            const response = await fetch(`${drFungitoUrl}/health`);
            if (response.ok) {
                connectionStatus.className = 'w-2 h-2 rounded-full bg-green-400';
                connectionStatus.title = 'Conectado al agente IA';
            } else {
                throw new Error('Service unavailable');
            }
        } catch (error) {
            connectionStatus.className = 'w-2 h-2 rounded-full bg-red-400';
            connectionStatus.title = 'Desconectado del agente IA';
        }
    }

    // Función para renderizar markdown básico
    function renderMarkdown(text) {
        return text
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/\n/g, '<br>')
            .replace(/🔗 <a href="(.*?)"(.*?)>(.*?)<\/a>/g, '<a href="$1" target="_blank" class="text-blue-500 hover:text-blue-700 underline font-semibold">$3</a>');
    }

    // Función para mostrar mensaje en el chat
    function displayMessage(message, isUser = false, isLoading = false) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `flex items-start space-x-2 ${isUser ? 'justify-end' : ''}`;
        
        if (isUser) {
            messageDiv.innerHTML = `
                <div class="bg-green-500 text-white p-3 rounded-lg theme-theme-shadow-light-light max-w-xs">
                    <p class="text-sm">${message}</p>
                </div>
                <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">👤</div>
            `;
        } else {
            const loadingIcon = isLoading ? '<div class="loading-spinner w-4 h-4 border-2 theme-border border-t-green-500 rounded-full animate-spin"></div>' : '';
            const renderedMessage = isLoading ? message : renderMarkdown(message);
            
            messageDiv.innerHTML = `
                <img src="/images/DrFungito.png" alt="Dr. Fungito" class="w-8 h-8 rounded-full object-cover flex-shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 hidden">🍄</div>
                <div class="theme-bg-primary p-3 rounded-lg theme-theme-shadow-light-light border theme-border max-w-xs">
                    <div class="flex items-center space-x-2">
                        ${loadingIcon}
                        <div class="text-sm theme-text-primary ${isLoading ? 'whitespace-pre-wrap' : ''}">${renderedMessage}</div>
                    </div>
                </div>
            `;
        }
        
        chatMessages.appendChild(messageDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        return messageDiv;
    }
    
    // Función para manejar acciones rápidas
    async function handleQuickAction(action) {
        switch (action) {
            case 'memory':
                await showUserMemory();
                break;
            case 'report':
                await generateQuickReport();
                break;
            case 'clear':
                await clearUserMemory();
                break;
            case 'help':
                showHelp();
                break;
        }
    }
    
    // Función para mostrar memoria del usuario
    async function showUserMemory() {
        const loadingMessage = displayMessage('Consultando tu memoria...', false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/memory?limit=5`, {
                headers: {
                    'X-User-Id': getUserId()
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al obtener memoria');
            }
            
            const memoryData = await response.json();
            loadingMessage.remove();
            
            const memoryText = `📊 **Tu Memoria Genómica:**\n\n` +
                `🖼️ Imágenes analizadas: ${memoryData.totalImages}\n` +
                `📄 Reportes generados: ${memoryData.totalReports}\n` +
                `📅 Última actividad: ${new Date(memoryData.lastActivity).toLocaleString()}\n\n` +
                `**Últimas imágenes:**\n` +
                memoryData.images.slice(0, 3).map(img => 
                    `• ${img.filename} (${img.analysisType})`
                ).join('\n') +
                `\n\n**Reportes disponibles:**\n` +
                memoryData.reports.slice(0, 3).map(report => 
                    `📄 ${report.title} - ${new Date(report.createdAt).toLocaleDateString()}`
                ).join('\n');
            
            displayMessage(memoryText);
            
            // Añadir un botón para ver debug detallado de reportes
            if (memoryData.totalReports > 0) {
                displayMessage('🔍 **Debug disponible:**\n' +
                    '• `debug reportes` - Ver todos los reportes\n' +
                    '• `debug [ID-REPORTE]` - Debug específico de un reporte');
            }
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ Error al consultar tu memoria. Verifica la conexión con el agente IA.');
        }
    }
    
    // Función para generar reporte rápido
    async function generateQuickReport() {
        const loadingMessage = displayMessage('🔄 Generando reporte PDF de tus análisis recientes...', false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/generate-report`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                },
                body: JSON.stringify({
                    reportType: 'summary',
                    title: 'Reporte Rápido de Análisis Genómico',
                    includeAllImages: false,
                    generatePDF: true
                })
            });
            
            if (!response.ok) {
                throw new Error('Error al generar reporte');
            }
            
            const reportData = await response.json();
            loadingMessage.remove();
            
            if (reportData.success && reportData.pdfAvailable) {
                // Reporte generado exitosamente
                const reportMessage = `🎉 **¡Reporte PDF Generado Exitosamente!**\n\n` +
                    `📄 **Título:** ${reportData.title}\n` +
                    `📊 **Imágenes incluidas:** ${reportData.imageCount}\n` +
                    `🔬 **Tipos de análisis:** ${reportData.analysisTypes.join(', ')}\n` +
                    `📅 **Fecha:** ${new Date(reportData.createdAt).toLocaleString()}\n\n` +
                    `✅ **PDF listo para descargar:**\n` +
                    `🔗 <a href="${drFungitoUrl}${reportData.downloadUrl}" target="_blank" style="color: #10b981; text-decoration: underline; font-weight: bold;">📥 Descargar Reporte PDF</a>\n\n` +
                    `💡 **Tip:** El reporte incluye todas las imágenes analizadas con sus interpretaciones detalladas y recomendaciones técnicas.`;
                
                displayMessage(reportMessage);
                
                // Mostrar comando de debug disponible
                displayMessage(`🔧 **Debug disponible**: Si hay problemas con la descarga, escribe "debug ${reportData.reportId}" para más información.`);
                
                // Mostrar notificación de éxito si está disponible
                if (window.Swal) {
                    Swal.fire({
                        icon: 'success',
                        title: '🎉 ¡Reporte PDF Generado!',
                        html: `Reporte con <strong>${reportData.imageCount}</strong> imágenes listo para descargar.`,
                        showConfirmButton: true,
                        confirmButtonText: '📥 Descargar Ahora',
                        confirmButtonColor: '#10b981'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.open(`${drFungitoUrl}${reportData.downloadUrl}`, '_blank');
                        }
                    });
                }
                
            } else {
                // Reporte generado pero sin PDF
                displayMessage(`📄 **Reporte generado exitosamente**\n\nRevisa la carpeta \`data/reports/\` y busca el ID del reporte: **${reportData.reportId}**\n\n${reportData.message || 'El reporte está disponible en el sistema de archivos.'}`);
            }
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ **Error al generar reporte**\n\nAsegúrate de haber analizado algunas imágenes primero usando los botones 🍄 en los visualizadores.');
        }
    }
    
    // Función para borrar memoria del usuario
    async function clearUserMemory() {
        // Confirmación antes de borrar
        const confirmed = confirm('🗑️ ¿Estás seguro de que quieres borrar toda tu memoria genómica?\n\nEsto eliminará:\n• Todas las imágenes analizadas\n• Todos los reportes generados\n• Todo el historial de chat\n\nEsta acción no se puede deshacer.');
        
        if (!confirmed) {
            return;
        }
        
        const loadingMessage = displayMessage('Borrando tu memoria genómica...', false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/clear-memory`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al borrar memoria');
            }
            
            loadingMessage.remove();
            
            // Limpiar el chat local también
            const messagesContainer = chatMessages;
            // Mantener solo el mensaje inicial de bienvenida
            const welcomeMessage = messagesContainer.children[0];
            messagesContainer.innerHTML = '';
            messagesContainer.appendChild(welcomeMessage);
            
            displayMessage('🗑️ **Memoria borrada exitosamente**\n\n✅ Todas tus imágenes analizadas han sido eliminadas\n✅ Todos los reportes generados han sido eliminados\n✅ El historial de chat ha sido limpiado\n\n🔄 Puedes comenzar de nuevo con análisis frescos.');
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ Error al borrar memoria. Intenta nuevamente o verifica la conexión con el agente IA.');
        }
    }
    
    // Función para mostrar ayuda
    function showHelp() {
        const helpText = `🤖 **Dr. Fungito AI - Ayuda:**\n\n` +
            `**Comandos disponibles:**\n` +
            `• "¿generar reporte?" - Crear reporte detallado\n` +
            `• "mostrar memoria" - Ver análisis anteriores\n` +
            `• "analizar [tipo]" - Información sobre análisis\n\n` +
            `**Capacidades:**\n` +
            `🔬 Análisis automático de gráficos genómicos\n` +
            `📊 Interpretación de resultados BinDash, anotaciones, etc.\n` +
            `📄 Generación de reportes inteligentes\n` +
            `🧠 Memoria contextual por usuario\n\n` +
            `**Tip:** Usa los botones en cada visualizador para análisis directo!`;
        
        displayMessage(helpText);
    }

    // Función para enviar mensaje
    async function handleSendMessage() {
        const message = userInput.value.trim();
        if (!message) return;

        // Deshabilitar input mientras se procesa
        sendButton.disabled = true;
        userInput.disabled = true;

        // Mostrar mensaje del usuario
        displayMessage(message, true);
        userInput.value = '';

        // Verificar si es un comando especial
        const lowerMessage = message.toLowerCase();
        if (lowerMessage.includes('debug')) {
            // Rehabilitar input
            sendButton.disabled = false;
            userInput.disabled = false;
            userInput.focus();
            
            // Verificar si es debug de reporte específico
            const reportIdMatch = message.match(/debug\s+([a-f0-9-]{36})/i);
            if (reportIdMatch) {
                const reportId = reportIdMatch[1];
                await debugSpecificReport(reportId);
                return;
            }
            
            // Si no es específico, mostrar debug general
            if (lowerMessage.includes('reporte')) {
                await showReportsDebug();
                return;
            }
            
            // Mostrar ayuda de debug
            displayMessage('🔧 **Comandos de Debug disponibles:**\n\n' +
                '• `debug reportes` - Ver todos los reportes\n' +
                '• `debug [ID-REPORTE]` - Debug específico de un reporte\n' +
                '• `debug cd57000a-5dd8-4a6a-9dff-0584bba7c75b` - Ejemplo con ID específico');
            return;
        }

        // Mostrar indicador de carga
        const loadingMessage = displayMessage('Analizando tu consulta...', false, true);

        try {
            // Enviar a Dr. Fungito AI Agent
            const response = await fetch(`${drFungitoUrl}/chat`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                },
                body: JSON.stringify({
                    message: message,
                    includeMemoryContext: true
                })
            });
            
            if (!response.ok) {
                throw new Error(`Error del servidor: ${response.status}`);
            }
            
            const data = await response.json();
            
            // Eliminar mensaje de carga
            loadingMessage.remove();
            
            // Mostrar respuesta del agente
            displayMessage(data.response, false);
            
        } catch (error) {
            console.error('Error al comunicarse con Dr. Fungito AI:', error);
            loadingMessage.remove();
            
            // Fallback a respuestas locales si el agente no está disponible
            const fallbackResponse = generateLocalResponse(message);
            displayMessage(`⚠️ Agente IA no disponible. Respuesta local:\n\n${fallbackResponse}`, false);
        } finally {
            // Rehabilitar input
            sendButton.disabled = false;
            userInput.disabled = false;
            userInput.focus();
        }
    }
    
    // Función para mostrar debug de reportes
    async function showReportsDebug() {
        const loadingMessage = displayMessage('Obteniendo información de debug...', false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/debug/reports`, {
                headers: {
                    'X-User-Id': getUserId()
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al obtener debug');
            }
            
            const debugData = await response.json();
            loadingMessage.remove();
            
            const debugText = `🔧 **Debug de Reportes:**\n\n` +
                `👤 **Usuario:** ${debugData.userId}\n` +
                `📄 **Total de reportes:** ${debugData.totalReports}\n\n` +
                `**Reportes disponibles:**\n` +
                debugData.reports.map(report => 
                    `📄 **${report.title}**\n` +
                    `   ID: ${report.reportId}\n` +
                    `   PDF: ${report.pdfAvailable ? '✅ Disponible' : '❌ No disponible'}\n` +
                    `   Imágenes: ${report.imageCount}\n` +
                    `   Descargas: ${report.downloadCount}\n` +
                    `   Fecha: ${new Date(report.createdAt).toLocaleDateString()}\n`
                ).join('\n');
            
            displayMessage(debugText);
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ Error al obtener información de debug. Revisa la conexión con el agente IA.');
        }
    }
    
    // Función para debug de reporte específico
    async function debugSpecificReport(reportId) {
        const loadingMessage = displayMessage(`Debugeando reporte ${reportId}...`, false, true);
        
        try {
            const response = await fetch(`${drFungitoUrl}/debug/report/${reportId}`, {
                headers: {
                    'X-User-Id': getUserId()
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al obtener debug del reporte');
            }
            
            const debugData = await response.json();
            loadingMessage.remove();
            
            const report = debugData.report;
            const debugText = `🔧 **Debug del Reporte: ${report.title}**\n\n` +
                `🆔 **ID:** ${report.reportId}\n` +
                `📄 **Título:** ${report.title}\n` +
                `📊 **Tipo:** ${report.type}\n` +
                `🖼️ **Imágenes:** ${report.imageCount}\n` +
                `🔬 **Análisis:** ${report.analysisTypes.join(', ')}\n` +
                `📅 **Creado:** ${new Date(report.createdAt).toLocaleString()}\n` +
                `📥 **Descargas:** ${report.downloadCount}\n` +
                `🔗 **URL:** ${report.downloadUrl}\n\n` +
                `**Estado del PDF:**\n` +
                `📁 **Ruta:** ${report.pdfPath}\n` +
                `✅ **Existe:** ${report.debug.pdfExists ? 'Sí' : 'No'}\n` +
                `📏 **Tamaño:** ${report.debug.pdfSize ? (report.debug.pdfSize / 1024).toFixed(2) + ' KB' : 'N/A'}\n` +
                `🕐 **Modificado:** ${report.debug.pdfModified ? new Date(report.debug.pdfModified).toLocaleString() : 'N/A'}\n\n` +
                `**Diagnóstico:**\n` +
                `${report.debug.pdfExists ? 
                    '✅ El archivo PDF existe y debería funcionar la descarga' : 
                    '❌ El archivo PDF no existe - esto explica el problema de descarga'}\n\n` +
                `**Enlace de descarga:**\n` +
                `🔗 <a href="${drFungitoUrl}${report.downloadUrl}" target="_blank" style="color: #10b981; text-decoration: underline; font-weight: bold;">📥 Intentar Descarga</a>`;
            
            displayMessage(debugText);
            
        } catch (error) {
            loadingMessage.remove();
            displayMessage('❌ Error al obtener debug del reporte específico. Revisa la conexión con el agente IA.');
        }
    }
    
    // Función para generar respuestas locales (fallback)
    function generateLocalResponse(message) {
        const lowerMessage = message.toLowerCase();
        
        if (lowerMessage.includes('reporte') || lowerMessage.includes('report')) {
            return '📄 Para generar un reporte detallado, usa los botones "Analizar Gráficos" en cualquier módulo del visualizador, luego haz clic en "Generar Reporte". También puedes usar el botón "📄 Generar reporte" arriba.';
        } else if (lowerMessage.includes('memoria') || lowerMessage.includes('memory')) {
            return '🧠 Tu memoria contiene todos los análisis de imágenes que hayas realizado. Usa el botón "📊 Ver mi memoria" para consultar tu historial de análisis.';
        } else if (lowerMessage.includes('eggnog') || lowerMessage.includes('anotación')) {
            return '🔬 Para análisis de anotaciones con eggNOG-mapper, usa el módulo "Visualizador de Anotaciones" y luego analiza los gráficos con Dr. Fungito AI.';
        } else if (lowerMessage.includes('bindash') || lowerMessage.includes('distancia')) {
            return '🧬 BinDash es excelente para comparaciones genómicas. Usa el "Visualizador BinDash" y luego el análisis IA para interpretación automática de matrices de distancia.';
        } else {
            return '🤖 Dr. Fungito AI no está disponible. Conecta el agente en puerto 4009 para análisis inteligente de imágenes, generación automática de reportes y chat contextual avanzado.';
        }
    }
    
    // Función para obtener ID de usuario
    function getUserId() {
        let userId = localStorage.getItem('drfungito_user_id');
        if (!userId) {
            userId = 'user_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            localStorage.setItem('drfungito_user_id', userId);
        }
        return userId;
    }

    // Event listeners
    sendButton.addEventListener('click', handleSendMessage);
    userInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            handleSendMessage();
        }
    });

    // Cerrar al hacer clic fuera
    document.addEventListener('click', (e) => {
        if (!drFungitoPanel.contains(e.target) && !drFungitoButton.contains(e.target)) {
            drFungitoPanel.classList.add('hidden');
        }
    });
    
    // Verificar conexión periódicamente
    setInterval(checkConnectionStatus, 30000); // Cada 30 segundos
    
    // Función global para que los visualizadores envíen imágenes al Dr. Fungito
    window.sendImageToDrFungito = async function(imageUrl, analysisType = 'general', filename = 'visualizer_image') {
        try {
            const response = await fetch(`${drFungitoUrl}/analyze-from-visualizer`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                },
                body: JSON.stringify({
                    imageUrl,
                    analysisType,
                    filename,
                    userContext: `Imagen del visualizador ${analysisType}`
                })
            });
            
            if (!response.ok) {
                throw new Error('Error al enviar imagen al Dr. Fungito');
            }
            
            const result = await response.json();
            
            // Mostrar notificación de éxito
            if (window.Swal) {
                Swal.fire({
                    icon: 'success',
                    title: '🍄 Enviado a Dr. Fungito!',
                    text: 'La imagen ha sido analizada y guardada en tu memoria genómica.',
                    showConfirmButton: false,
                    timer: 3000,
                    toast: true,
                    position: 'top-end'
                });
            }
            
            // Abrir el panel de Dr. Fungito si está cerrado
            if (drFungitoPanel.classList.contains('hidden')) {
                drFungitoPanel.classList.remove('hidden');
            }
            
            // Mostrar el análisis en el chat
            displayMessage(`📊 **Análisis completado para: ${filename}**\n\n${result.analysis}`);
            
            return result;
            
        } catch (error) {
            console.error('Error al enviar imagen al Dr. Fungito:', error);
            
            if (window.Swal) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'No se pudo enviar la imagen al Dr. Fungito. Verifica la conexión.',
                    confirmButtonColor: '#10b981'
                });
            }
            
            throw error;
        }
    };
    
    // Función para obtener historial de chat
    window.getDrFungitoHistory = async function() {
        try {
            const response = await fetch(`${drFungitoUrl}/chat-history?limit=10`, {
                headers: {
                    'X-User-Id': getUserId()
                }
            });
            
            if (!response.ok) {
                throw new Error('Error al obtener historial');
            }
            
            return await response.json();
            
        } catch (error) {
            console.error('Error al obtener historial:', error);
            return { history: [], totalChats: 0 };
        }
    };
});
</script> 